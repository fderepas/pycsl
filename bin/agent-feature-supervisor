#!/usr/bin/env bash
# agent-feature-supervisor — thin wrapper.
#
# Orchestrates an approved missing-*-feature.md plan through the
# verification gate. V1 is gate-only: never edits load-bearing
# files autonomously. See:
#   - better-agent.md Phase 3
#   - cmmi-tailoring-plan-follow-up.md Item 1.3
#   - src/pycsl/agents/agent-feature-supervisor.py (implementation)

set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$HERE/.." && pwd)"
exec python3 "$REPO_ROOT/src/pycsl/agents/agent-feature-supervisor.py" "$@"
