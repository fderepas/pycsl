# Python
__pycache__/
*.pyc
*.pyo
.venv/

# PyCSL generated output
pycsl_ir.json
pycsl_out.mlw
*.mlw

# Runtime / temp
out.std
out.err
result.txt
q.txt
tmp/
*.tmp

# Backup files
*~
\#*\#
.\#*

# Environment
.env

# Data directory (except lib_stubs which is tracked)
data/embeddings/
data/memory/
data/cache/

# Project workspace (untracked)
my_project/
project/
site-packages/
metrics/

# CMMI Profile-P operational artefacts (Follow-up #2 Item 3.1):
# bridge-mirrored agent inboxes — runtime queue, not tracked
projects/pycsl/message-queues/*/
!projects/pycsl/message-queues/.gitkeep
# bridge cursor state (regenerated on each run)
projects/pycsl/message-queues/.bridge-cursor.json
# metrics cron logs and lock files
metrics/cron.log
metrics/.cmmi-*.lock

.claude/
