(* pycsl-wp-spec.mlw — Layer 3 Why3 Specification Module
 *
 * One val declaration per WP arm in Phase4_WP.v.
 * Each val's contract mirrors the corresponding Rocq fixpoint arm exactly.
 * SFor: handle_for_init + handle_for_code added; desugar_correct proved (plan-formal-03).
 * Full SFor coherence via wp_for_desugar is now PROVED
 *   (src/formal-semantics/rocq/Phase5c_WpForDesugar.v: wp_for_desugar / wp_desugar_iff,
 *    0 Admitted; Print Assumptions = only the two standard extensionality axioms).
 *
 * Audit trail: for each val, a comment cites the exact Rocq source line.
 * Human-audited link: the ensures clause is written by inspection of Phase4_WP.v.
 * Machine-checked link: Why3 verifies that any concrete implementation
 *   provided via clone satisfies these contracts.
 *)

module PyCSL_WP_Spec

  use int.Int
  use map.Map as M
  use map.Const as MC

  (* ── Abstract types (mirror Phase1_AST.v + Phase2_State.v) ─────────────── *)

  (* Phase1_AST.v:14  Definition ident := string. *)
  type ident = string

  (* Phase2_State.v:9–11  Inductive val := VInt (n : Z) | VArray (a : list Z). *)
  type value = VInt int | VArray (M.map int int) | VNone

  (* Phase2_State.v:14  Definition state := list (ident * val).
   * Here represented as a total map for Why3 compatibility.
   * The correspondence is argued by the shared axioms below. *)
  type state = M.map ident value

  (* ── Core state operations (abstract — mirror Phase2_State.v) ───────────── *)

  (* Phase2_State.v:25  Definition update st x v := (x, v) :: st. *)
  function update (st: state) (x: ident) (v: value) : state =
    M.set st x v

  (* Phase2_State.v:17  Fixpoint lookup st x. *)
  function lookup (st: state) (x: ident) : value =
    M.get st x

  (* Phase2_State.v:50  Fixpoint eval_expr st e. (total function)
   * Left abstract: the full expression evaluator is large; its totality
   * is established in Rocq.  Concrete uses pass e_val = eval_expr st e. *)
  val function eval_expr (st: state) (e: ident) : value

  (* ── Axioms grounding update / lookup — match Phase2_State.v exactly ────── *)

  (* Phase2_State.v:25  update is cons-shadowing; lookup finds the first binding. *)
  axiom update_lookup_same :
    forall st : state, x : ident, v : value.
    lookup (update st x v) x = v

  axiom update_lookup_other :
    forall st : state, x y : ident, v : value.
    x <> y -> lookup (update st y v) x = lookup st x

  (* ── WP arm specifications ───────────────────────────────────────────────── *)

  (* Phase4_WP.v:21
   *   | SSkip => Qn st
   * After a skip, the state is unchanged. *)
  val handle_skip (st: state) : state
    ensures { result = st }

  (* Phase4_WP.v:23–24
   *   | SAssign x e =>
   *       Qn (update st x (eval_expr st e))
   * After assigning e_val to x, the state has x bound to e_val. *)
  val handle_assign (x: ident) (e_val: value) (st: state) : state
    ensures { result = update st x e_val }

  (* Phase4_WP.v:26–30
   *   | SAugAssign x op e =>
   *       let cur := ... in let nv := eval_binop_z op cur ... in
   *       Qn (update st x (VInt nv))
   * After an augmented assignment, x is bound to new_val. *)
  val handle_aug_assign (x: ident) (new_val: value) (st: state) : state
    ensures { result = update st x new_val }

  (* Phase4_WP.v:32–35
   *   | SArraySet arr i v =>
   *       let idx := ... in let nv := ... in
   *       Qn (array_update st arr idx nv)
   * After arr[i] := new_val, the array at position i holds new_val.
   * Precondition i >= 0 mirrors Phase2_State.v:30 bounds check. *)
  val handle_array_set (arr: ident) (i: int) (new_val: int) (st: state) : state
    requires { 0 <= i }
    ensures  {
      lookup result arr =
        VArray (M.set
          (match lookup st arr with
           | VArray a -> a
           | _        -> MC.const 0
           end)
          i new_val)
    }

  (* Phase4_WP.v:37–39
   *   | SSeq s1 s2 =>
   *       wp s1 (fun st' => wp s2 Qn Qr Qc pre_st st') Qr Qc pre_st st
   * Sequencing is structural: the Qn of s1 becomes the initial state for s2.
   * No separate val needed — the calling convention of _stmts_to_whyml
   * (concatenate with ";\n") realises this threading.  The handle_seq val
   * documents the identity property of the threading step. *)
  val handle_seq (st_after_s1: state) : state
    ensures { result = st_after_s1 }

  (* Phase4_WP.v:41–43
   *   | SIf cond s1 s2 =>
   *       (eval_bool st cond = true  -> wp s1 ...) /\
   *       (eval_bool st cond = false -> wp s2 ...)
   * Branching is pure dispatch: the state entering each branch is unchanged. *)
  val handle_if_branch (st: state) : state
    ensures { result = st }

  (* Phase4_WP.v:45–66  | SWhile inv var cond body
   *
   * The SWhile WP rule has three conjuncts.  Each is a separate val so the
   * audit can check each conjunct independently.
   *
   * Conjunct 1 (Phase4_WP.v:46):
   *   eval_contract st pre_st None inv
   * The invariant must hold at loop entry. *)
  val check_while_inv_entry (inv_holds: bool) : unit
    requires { inv_holds = True }

  (* Conjunct 2 (Phase4_WP.v:47–62):
   *   forall st', inv(st') -> cond(st') ->
   *     wp body (fun st'' =>
   *       inv(st'') /\ var(st'') < var(st') /\ var(st'') >= 0) ...
   * Each body iteration preserves the invariant and decreases the variant. *)
  val check_while_body_step
    (inv_after: bool) (var_before: int) (var_after: int) : unit
    requires { var_before >= 0 }
    ensures  { inv_after = True }
    ensures  { 0 <= var_after < var_before }

  (* Conjunct 3 (Phase4_WP.v:63–66):
   *   forall st', inv(st') -> cond(st') = false -> Qn st'
   * When the loop condition is false, the normal postcondition holds
   * in the current state — the state is passed through unchanged. *)
  val handle_while_exit (st: state) : state
    ensures { result = st }

  (* Phase4_WP.v:68–94  | SFor x arr inv var body
   * desugar_correct proved (plan-formal-03): exec st (SFor...) out ↔ exec st (desugar (SFor...)) out.
   * The SFor WP initializes _pycsl_idx to 0, then runs the desugared while loop.
   * handle_for captures the init step; the while loop state transition is handled
   * by handle_while_* above.  Full coherence (wp_for_desugar) is now PROVED
   * (Phase5c_WpForDesugar.v, 0 Admitted). *)
  val handle_for_init (idx_var : ident) (st : state) : state
    ensures { result = update st idx_var (VInt 0) }

  (* Phase4_WP.v:96–97
   *   | SReturn e =>
   *       Qr (update st "\\result" (eval_expr st e))
   * After a return, the state has "\result" bound to e_val. *)
  val handle_return (e_val: value) (st: state) : state
    ensures { result = update st "\\result" e_val }

  (* Phase4_WP.v:99–100
   *   | SContinue =>
   *       Qc st
   * A continue statement passes the state through unchanged. *)
  val handle_continue (st: state) : state
    ensures { result = st }

end

(* ── PyCSL_WP_Code ───────────────────────────────────────────────────────────
 * String-level specifications for Module6 code generators.
 * Each val specifies WHAT STRING the code generator must produce.
 * Companion to PyCSL_WP_Spec (which specifies the state transformation).
 * See src/self-annotate/semantic-ceiling.md §3 Step 2 for rationale.
 *)
module PyCSL_WP_Code

  use string.String
  use bool.Bool

  function (^) (s1 s2: string) : string = String.concat s1 s2

  (* Phase4_WP.v:23–24  | SAssign x e
   *
   * The Python implementation produces one of two binding forms:
   *   declared=true  → ref-update:  `indent ^ lhs ^ " := " ^ rhs ^ ";\n" ^ rest`
   *   declared=false → let-binding: `indent ^ "let " ^ lhs ^ " = ref " ^ rhs ^ " in\n" ^ rest`
   *                    or (array/lambda/dict) `... ^ "let " ^ lhs ^ " = " ^ rhs ^ " in\n" ^ rest`
   *
   * Human-audited: checked line-by-line against _handle_assign_stmt in
   * Module6_WhyMLTranspiler.py:1388–1424.
   *)
  val function handle_assign_code
      (lhs rhs_str indent rest_str : string) (declared : bool) : string
    ensures {
      declared ->
        result = indent ^ lhs ^ " := " ^ rhs_str ^ ";\n" ^ rest_str
    }
    ensures {
      not declared ->
           result = indent ^ "let " ^ lhs ^ " = ref " ^ rhs_str ^ " in\n" ^ rest_str
        \/ result = indent ^ "let " ^ lhs ^ " = "     ^ rhs_str ^ " in\n" ^ rest_str
    }

  (* Phase4_WP.v:21  | SSkip => Qn st
   * A skip (pass) statement emits "()" then chains rest with ";\n" ONLY when rest
   * is non-empty (faithful to _stmts_to_whyml's `if rest: code += ";\n"+rest`), so
   * the no-rest form is reached IFF rest_str = "". This rest-conditioned ensures
   * (was a free disjunction) is what makes skip coherence a proved lemma. *)
  val function handle_skip_code (indent rest_str : string) : string
    ensures { rest_str =  "" -> result = indent ^ "()" }
    ensures { rest_str <> "" -> result = indent ^ "()" ^ ";\n" ^ rest_str }

  (* Phase4_WP.v:26–30  | SAugAssign x op e
   * Two forms: arithmetic op (form 2) or bitwise via abstract function (form 1). *)
  val function handle_aug_assign_code
      (lhs op_str rhs_str indent rest_str : string) (is_bitwise : bool) : string
    ensures {
      is_bitwise ->
        result = indent ^ lhs ^ " := (" ^ op_str ^ " !" ^ lhs ^ " " ^ rhs_str ^ ");\n" ^ rest_str
    }
    ensures {
      not is_bitwise ->
        result = indent ^ lhs ^ " := !" ^ lhs ^ " " ^ op_str ^ " " ^ rhs_str ^ ";\n" ^ rest_str
    }

  (* Phase4_WP.v:32–35  | SArraySet arr i v
   * Direct array mutation: arr[idx] <- val. *)
  (* rest-conditioned (faithful to _handle_array_set_stmt's `if rest: code +=
   * ";\n"+rest`): the no-rest form is reached IFF rest_str = "". *)
  val function handle_array_set_code
      (arr idx_str val_str indent rest_str : string) : string
    ensures { rest_str =  "" ->
      result = indent ^ arr ^ "[" ^ idx_str ^ "] <- " ^ val_str }
    ensures { rest_str <> "" ->
      result = indent ^ arr ^ "[" ^ idx_str ^ "] <- " ^ val_str ^ ";\n" ^ rest_str }

  (* Phase4_WP.v:37–39  | SSeq s1 s2
   * Sequencing is string concatenation: output of s1 followed by output of s2. *)
  val function handle_seq_code (s1_str s2_str : string) : string
    ensures { result = s1_str ^ ";\n" ^ s2_str
           \/ result = s1_str ^ s2_str }

  (* Phase4_WP.v:41–43  | SIf cond s1 s2
   * Two forms: if/else (has_else=true) or if-only (has_else=false). *)
  val function handle_if_code
      (cond_str then_str else_str indent : string) (has_else : bool) : string
    ensures {
      has_else ->
        result = indent ^ "if " ^ cond_str ^ " then begin\n" ^ then_str
               ^ indent ^ "end else begin\n" ^ else_str ^ indent ^ "end"
    }
    ensures {
      not has_else ->
        result = indent ^ "if " ^ cond_str ^ " then begin\n" ^ then_str ^ indent ^ "end"
    }

  (* Phase4_WP.v:45–66  | SWhile inv var cond body
   * While loop with invariant, variant, and body. *)
  val function handle_while_code
      (cond_str inv_str var_str body_str indent : string) : string
    ensures {
      result = indent ^ "while " ^ cond_str ^ " do\n"
             ^ indent ^ "  invariant { " ^ inv_str ^ " }\n"
             ^ indent ^ "  variant   { " ^ var_str ^ " }\n"
             ^ body_str
             ^ indent ^ "done"
    }

  (* Phase4_WP.v:68–94  | SFor x arr inv var body
   * desugar_correct proved (plan-formal-03).
   * The for loop generates: let idx = ref 0 in  while !idx < len_str do ... done.
   * inv_str and var_str are the pre-formatted invariant/variant annotation lines. *)
  val function handle_for_code
      (idx_var len_str elem_bind body_str inv_str var_str indent inner : string) : string
    ensures {
      result = indent ^ "let " ^ idx_var ^ " = ref 0 in\n"
             ^ inner ^ "while !" ^ idx_var ^ " < " ^ len_str ^ " do\n"
             ^ inv_str ^ var_str
             ^ inner ^ "  " ^ elem_bind ^ "\n"
             ^ body_str
             ^ inner ^ "  " ^ idx_var ^ " := !" ^ idx_var ^ " + 1;\n"
             ^ inner ^ "done"
    }

  (* Phase4_WP.v:96–97  | SReturn e
   * Two forms: raise Return exception (in_loop/has_early_ret) or plain value. *)
  val function handle_return_code
      (val_str indent : string) (use_raise : bool) : string
    ensures {
      use_raise ->
        result = indent ^ "raise (Return " ^ val_str ^ ")"
             \/ result = indent ^ "raise Return_void"
    }
    ensures {
      not use_raise ->
        result = indent ^ val_str
    }

  (* Phase4_WP.v:99–100  | SContinue
   * Continue raises the PyCSL_Continue exception caught by the enclosing loop. *)
  val function handle_continue_code (indent : string) : string
    ensures { result = indent ^ "raise PyCSL_Continue" }

end

(* ── PyCSL_WP_Coherence ──────────────────────────────────────────────────────
 * Bridge between PyCSL_WP_Code (string-level) and PyCSL_WP_Spec (state-level).
 * Axiomatizes the denotational semantics of the generated WhyML fragments and
 * proves that code generation is coherent with state transformation.
 * See src/self-annotate/semantic-ceiling.md §3 Step 3 for rationale.
 *)
module PyCSL_WP_Coherence

  use PyCSL_WP_Spec
  use PyCSL_WP_Code
  use string.String
  use int.Int

  function (^) (s1 s2: string) : string = String.concat s1 s2

  (* Abstract denotational semantics of a WhyML expression string.
   * Axiomatized — the full WhyML interpreter is not in scope.
   * Human-audited against Phase2_State.v eval_expr. *)
  val function eval_whyml_expr (s: string) (st: state) : value

  (* Abstract denotational semantics of a WhyML statement string. *)
  val function eval_whyml_stmts (s: string) (st: state) : state

  (* Audited evaluator axiom: the empty statement string is the identity on state
   * (an empty program does nothing). This is the atomic fact that lets the no-rest
   * emission branch (reached IFF rest_str = "") satisfy the coherence RHS
   * `eval_whyml_stmts rest_str …` — it replaces the bundled "human-audited"
   * skip/array_set COHERENCE axioms with proved lemmas resting on this + the
   * per-construct semantics axioms (trust relocated to the more atomic layer). *)
  axiom eval_empty_semantics :
    forall st. eval_whyml_stmts "" st = st

  (* Axiom: `lhs := rhs;\n` followed by rest_str updates lhs then runs rest.
   * Semantic content of the WP SAssign ref-update arm. *)
  axiom assign_ref_update_semantics :
    forall lhs rhs_str rest_str indent st.
    eval_whyml_stmts
      (indent ^ lhs ^ " := " ^ rhs_str ^ ";\n" ^ rest_str) st
    =
    eval_whyml_stmts rest_str (update st lhs (eval_whyml_expr rhs_str st))

  (* Axiom: `let lhs = ref rhs in\n` followed by rest_str has the same semantics. *)
  axiom assign_let_ref_semantics :
    forall lhs rhs_str rest_str indent st.
    eval_whyml_stmts
      (indent ^ "let " ^ lhs ^ " = ref " ^ rhs_str ^ " in\n" ^ rest_str) st
    =
    eval_whyml_stmts rest_str (update st lhs (eval_whyml_expr rhs_str st))

  (* Axiom: `let lhs = rhs in\n` (array/lambda/dict form) has the same semantics. *)
  axiom assign_let_semantics :
    forall lhs rhs_str rest_str indent st.
    eval_whyml_stmts
      (indent ^ "let " ^ lhs ^ " = " ^ rhs_str ^ " in\n" ^ rest_str) st
    =
    eval_whyml_stmts rest_str (update st lhs (eval_whyml_expr rhs_str st))

  (* Coherence theorem: the string produced by handle_assign_code, when evaluated,
   * yields the state transformation required by the WP SAssign rule.
   *
   * Proof: by case split on `declared`.
   *   declared=true:  handle_assign_code ensures (1st clause) + assign_ref_update_semantics
   *   declared=false: handle_assign_code ensures (2nd clause, disjunction) +
   *                   assign_let_ref_semantics or assign_let_semantics
   * In both cases, eval_whyml_expr e_val_str st = e_val by hypothesis.
   *
   * Prover note: discharged by Z3 4.13.3 (0.02s); Alt-Ergo times out on string
   * concatenation axioms.  Verify with: why3 prove -P "Z3,4.13.3," this-file.mlw *)
  lemma assign_code_state_coherent :
    forall lhs e_val_str rest_str indent declared st e_val.
    eval_whyml_expr e_val_str st = e_val ->
    let code = handle_assign_code lhs e_val_str indent rest_str declared in
    eval_whyml_stmts code st
    =
    eval_whyml_stmts rest_str (update st lhs e_val)

  (* ── SSkip semantics + coherence ────────────────────────────────────────── *)

  (* Axiom: "()\n" evaluates as the identity on state. *)
  axiom skip_semantics :
    forall indent rest_str st.
    eval_whyml_stmts (indent ^ "()" ^ ";\n" ^ rest_str) st
    = eval_whyml_stmts rest_str st

  axiom skip_semantics_norest :
    forall indent st.
    eval_whyml_stmts (indent ^ "()") st = st

  (* PROMOTED from an audited axiom to a proved `let lemma` (b14/finishable-path).
   * Guided case-split on whether rest_str is empty:
   *   rest_str =  "" : code = indent^"()"; eval = st (skip_semantics_norest) and
   *                    eval rest_str st = eval "" st = st (eval_empty_semantics).
   *   rest_str <> "" : code = indent^"()"^";\n"^rest; eval = eval rest_str st
   *                    (skip_semantics).
   * Each assert holds under a single branch hypothesis (no Z3 disjunction split). *)
  let lemma skip_code_state_coherent (indent rest_str : string) (st : state)
    ensures { eval_whyml_stmts (handle_skip_code indent rest_str) st
              = eval_whyml_stmts rest_str st }
  = let code = handle_skip_code indent rest_str in
    assert { rest_str =  "" -> eval_whyml_stmts code st = eval_whyml_stmts rest_str st };
    assert { rest_str <> "" -> eval_whyml_stmts code st = eval_whyml_stmts rest_str st }

  (* ── SAugAssign semantics + coherence ───────────────────────────────────── *)

  (* Axiom: arithmetic augmented assignment updates lhs. *)
  axiom aug_assign_arith_semantics :
    forall lhs op_str rhs_str indent rest_str st cur_val rhs_val result_val.
    lookup st lhs = cur_val ->
    eval_whyml_expr rhs_str st = rhs_val ->
    eval_whyml_expr ("!" ^ lhs ^ " " ^ op_str ^ " " ^ rhs_str) st = result_val ->
    eval_whyml_stmts
      (indent ^ lhs ^ " := !" ^ lhs ^ " " ^ op_str ^ " " ^ rhs_str ^ ";\n" ^ rest_str) st
    = eval_whyml_stmts rest_str (update st lhs result_val)

  (* Axiom: bitwise augmented assignment via abstract op updates lhs. *)
  axiom aug_assign_bitwise_semantics :
    forall lhs op_str rhs_str indent rest_str st result_val.
    eval_whyml_expr ("(" ^ op_str ^ " !" ^ lhs ^ " " ^ rhs_str ^ ")") st = result_val ->
    eval_whyml_stmts
      (indent ^ lhs ^ " := (" ^ op_str ^ " !" ^ lhs ^ " " ^ rhs_str ^ ");\n" ^ rest_str) st
    = eval_whyml_stmts rest_str (update st lhs result_val)

  lemma aug_assign_code_state_coherent :
    forall lhs op_str rhs_str indent rest_str st result_val is_bitwise.
    eval_whyml_expr
      (if is_bitwise
       then "(" ^ op_str ^ " !" ^ lhs ^ " " ^ rhs_str ^ ")"
       else "!" ^ lhs ^ " " ^ op_str ^ " " ^ rhs_str) st = result_val ->
    let code = handle_aug_assign_code lhs op_str rhs_str indent rest_str is_bitwise in
    eval_whyml_stmts code st = eval_whyml_stmts rest_str (update st lhs result_val)

  (* ── SArraySet semantics + coherence ────────────────────────────────────── *)

  (* The array-set result state, NAMED as a logic function so Z3 sees identical
   * opaque applications (reflexive equality) instead of repeatedly destructuring
   * the inline update/VArray/M.set/match term — which made the coherence proof
   * explode (>23M steps / timeout). With the name it discharges in milliseconds. *)
  function arr_set_state (st: state) (arr: string) (idx_val new_val: int) : state =
    update st arr
      (VArray (M.set
        (match lookup st arr with VArray a -> a | _ -> MC.const 0 end)
        idx_val new_val))

  (* Axiom: `arr[idx] <- val;\n rest` sets element idx of arr, then runs rest.
   * Explicit trigger on the emitted with-rest string. *)
  axiom array_set_semantics :
    forall arr idx_str val_str indent rest_str st idx_val new_val
      [eval_whyml_stmts (indent ^ arr ^ "[" ^ idx_str ^ "] <- " ^ val_str ^ ";\n" ^ rest_str) st].
    eval_whyml_expr idx_str st = VInt idx_val ->
    eval_whyml_expr val_str st = VInt new_val ->
    eval_whyml_stmts
      (indent ^ arr ^ "[" ^ idx_str ^ "] <- " ^ val_str ^ ";\n" ^ rest_str) st
    = eval_whyml_stmts rest_str (arr_set_state st arr idx_val new_val)

  (* Audited evaluator axiom: the no-rest array-set string sets element idx (no continuation). *)
  axiom array_set_semantics_norest :
    forall arr idx_str val_str indent st idx_val new_val
      [eval_whyml_stmts (indent ^ arr ^ "[" ^ idx_str ^ "] <- " ^ val_str) st].
    eval_whyml_expr idx_str st = VInt idx_val ->
    eval_whyml_expr val_str st = VInt new_val ->
    eval_whyml_stmts (indent ^ arr ^ "[" ^ idx_str ^ "] <- " ^ val_str) st
    = arr_set_state st arr idx_val new_val

  (* PROMOTED from an audited axiom to a proved `let lemma` (b14/finishable-path).
   * Guided case-split on rest_str: rest="" uses array_set_semantics_norest +
   * eval_empty_semantics; rest<>"" uses array_set_semantics. Trust is relocated to
   * the per-construct evaluator axioms; the coherence itself is now machine-checked. *)
  let lemma array_set_code_state_coherent
      (arr idx_str val_str indent rest_str : string) (st : state)
      (idx_val new_val : int)
    requires { eval_whyml_expr idx_str st = VInt idx_val }
    requires { eval_whyml_expr val_str st = VInt new_val }
    ensures  { eval_whyml_stmts (handle_array_set_code arr idx_str val_str indent rest_str) st
               = eval_whyml_stmts rest_str (arr_set_state st arr idx_val new_val) }
  = let code = handle_array_set_code arr idx_str val_str indent rest_str in
    assert { eval_whyml_stmts (indent ^ arr ^ "[" ^ idx_str ^ "] <- " ^ val_str ^ ";\n" ^ rest_str) st
             = eval_whyml_stmts rest_str (arr_set_state st arr idx_val new_val) };
    assert { eval_whyml_stmts (indent ^ arr ^ "[" ^ idx_str ^ "] <- " ^ val_str) st
             = arr_set_state st arr idx_val new_val };
    assert { eval_whyml_stmts "" (arr_set_state st arr idx_val new_val)
             = arr_set_state st arr idx_val new_val };
    assert { rest_str =  "" -> eval_whyml_stmts code st
             = eval_whyml_stmts rest_str (arr_set_state st arr idx_val new_val) };
    assert { rest_str <> "" -> eval_whyml_stmts code st
             = eval_whyml_stmts rest_str (arr_set_state st arr idx_val new_val) }

  (* ── SSeq semantics + coherence ─────────────────────────────────────────── *)

  (* Axiom: sequencing is s2 applied to the state after s1. *)
  axiom seq_semantics :
    forall s1_str s2_str st.
    eval_whyml_stmts (s1_str ^ ";\n" ^ s2_str) st
    = eval_whyml_stmts s2_str (eval_whyml_stmts s1_str st)

  axiom seq_concat_semantics :
    forall s1_str s2_str st.
    eval_whyml_stmts (s1_str ^ s2_str) st
    = eval_whyml_stmts s2_str (eval_whyml_stmts s1_str st)

  (* b14/finishable-path: PROMOTED from an audited axiom to a proved `let lemma`
   * via a GUIDED case-split. handle_seq_code returns `s1^";\n"^s2` OR `s1^s2`;
   * both disjuncts have the SAME semantics (`seq_semantics` / `seq_concat_semantics`
   * each give `eval s2 (eval s1 st)`). The two per-disjunct assertions below each
   * instantiate exactly ONE semantics axiom under its branch hypothesis (no split
   * inside), and handle_seq_code's disjunctive ensures combines them — so Z3
   * discharges it cheaply instead of timing out on the raw 5s/1.45M-step split. *)
  let lemma seq_code_state_coherent (s1_str s2_str : string) (st st_mid : state)
    requires { eval_whyml_stmts s1_str st = st_mid }
    ensures  { eval_whyml_stmts (handle_seq_code s1_str s2_str) st
               = eval_whyml_stmts s2_str st_mid }
  = let code = handle_seq_code s1_str s2_str in
    assert { code = s1_str ^ ";\n" ^ s2_str ->
             eval_whyml_stmts code st = eval_whyml_stmts s2_str st_mid };
    assert { code = s1_str ^ s2_str ->
             eval_whyml_stmts code st = eval_whyml_stmts s2_str st_mid }

  (* ── SIf semantics + coherence ──────────────────────────────────────────── *)

  (* Axiom: if/else dispatch based on cond. *)
  axiom if_else_semantics :
    forall cond_str then_str else_str indent st cond_val.
    eval_whyml_expr cond_str st = cond_val ->
    eval_whyml_stmts
      (indent ^ "if " ^ cond_str ^ " then begin\n" ^ then_str
       ^ indent ^ "end else begin\n" ^ else_str ^ indent ^ "end") st
    = (if cond_val <> VInt 0
       then eval_whyml_stmts then_str st
       else eval_whyml_stmts else_str st)

  (* Axiom: if-only dispatch (no else branch — state unchanged if cond false). *)
  axiom if_only_semantics :
    forall cond_str then_str indent st cond_val.
    eval_whyml_expr cond_str st = cond_val ->
    eval_whyml_stmts
      (indent ^ "if " ^ cond_str ^ " then begin\n" ^ then_str ^ indent ^ "end") st
    = (if cond_val <> VInt 0
       then eval_whyml_stmts then_str st
       else st)

  lemma if_code_state_coherent :
    forall cond_str then_str else_str indent st cond_val.
    eval_whyml_expr cond_str st = cond_val ->
    forall has_else.
    let code = handle_if_code cond_str then_str else_str indent has_else in
    (has_else ->
      eval_whyml_stmts code st
      = (if cond_val <> VInt 0
         then eval_whyml_stmts then_str st
         else eval_whyml_stmts else_str st))
    /\
    (not has_else ->
      eval_whyml_stmts code st
      = (if cond_val <> VInt 0
         then eval_whyml_stmts then_str st
         else st))


  (* ── SWhile semantics + coherence ───────────────────────────────────────── *)

  (* Axiom: while loop evaluates to a fixed-point state.
   * Left abstract (the full fixpoint semantics is modeled in Phase5a_WhileInv.v).
   * Human-audited: this axiom matches the SWhile WP rule fixpoint structure. *)
  val function eval_while_fixpoint
      (cond_str body_str inv_str var_str indent : string) (st: state) : state

  axiom while_semantics :
    forall cond_str inv_str var_str body_str indent st.
    eval_whyml_stmts
      (indent ^ "while " ^ cond_str ^ " do\n"
       ^ indent ^ "  invariant { " ^ inv_str ^ " }\n"
       ^ indent ^ "  variant   { " ^ var_str ^ " }\n"
       ^ body_str ^ indent ^ "done") st
    = eval_while_fixpoint cond_str body_str inv_str var_str indent st

  lemma while_code_state_coherent :
    forall cond_str inv_str var_str body_str indent st.
    let code = handle_while_code cond_str inv_str var_str body_str indent in
    eval_whyml_stmts code st
    = eval_while_fixpoint cond_str body_str inv_str var_str indent st

  (* ── SReturn semantics + coherence ─────────────────────────────────────── *)

  (* Axiom: raise (Return v) sets \result in state and exits via exception. *)
  axiom return_raise_semantics :
    forall val_str indent st e_val.
    eval_whyml_expr val_str st = e_val ->
    eval_whyml_stmts (indent ^ "raise (Return " ^ val_str ^ ")") st
    = update st "\\result" e_val

  (* Axiom: raise Return_void exits with unchanged state (unit return). *)
  axiom return_void_semantics :
    forall indent st.
    eval_whyml_stmts (indent ^ "raise Return_void") st = st

  (* Axiom: plain value return (not in_loop) sets \result. *)
  axiom return_plain_semantics :
    forall val_str indent st e_val.
    eval_whyml_expr val_str st = e_val ->
    eval_whyml_stmts (indent ^ val_str) st
    = update st "\\result" e_val

  (* Note: return_code_state_coherent is split by case.
   * The void case (Return_void) preserves state unchanged (see return_void_semantics).
   * The value case (raise (Return v)) sets \result (see return_raise_semantics).
   * A single combined lemma would be unsound for void returns; the two axioms
   * above separately cover each branch.
   *
   * b14/finishable-path Steps 3-4: PROMOTED from `axiom` to a proved `lemma`.
   * For use_raise=false the code spec `handle_return_code` has a SINGLE form
   * (`result = indent ^ val_str`, no disjunction), so coherence discharges
   * directly from `return_plain_semantics` — no Z3 string case-split (unlike the
   * skip/seq/array_set arms whose code specs carry a free with/without-rest
   * disjunction). This shrinks the audited-axiom TCB by one. *)
  lemma return_plain_code_state_coherent :
    forall val_str indent st e_val.
    eval_whyml_expr val_str st = e_val ->
    let code = handle_return_code val_str indent false in
    eval_whyml_stmts code st = update st "\\result" e_val

  (* ── SContinue semantics + coherence ────────────────────────────────────── *)

  (* Axiom: raise PyCSL_Continue passes state through (exception is caught by loop). *)
  axiom continue_semantics :
    forall indent st.
    eval_whyml_stmts (indent ^ "raise PyCSL_Continue") st = st

  lemma continue_code_state_coherent :
    forall indent st.
    let code = handle_continue_code indent in
    eval_whyml_stmts code st = st

  (* ── SFor semantics + coherence ─────────────────────────────────────────── *)

  (* Axiom: the for-loop code initializes idx to 0 then runs the while body.
   * desugar_correct (plan-formal-03) justifies the desugaring is semantics-preserving.
   * Full coherence (what the while loop computes) via wp_for_desugar is now PROVED
   * (Phase5c_WpForDesugar.v, 0 Admitted).
   * Human-audited against Phase4_WP.v:69–95.
   * Note: handle_for_init is a program val; we use update directly in logic. *)
  axiom for_code_init_semantics :
    forall idx_var len_str elem_bind body_str inv_str var_str indent inner st.
    let code = handle_for_code idx_var len_str elem_bind body_str inv_str var_str indent inner in
    eval_whyml_stmts code st
    = eval_whyml_stmts
        (inner ^ "while !" ^ idx_var ^ " < " ^ len_str ^ " do\n"
         ^ inv_str ^ var_str
         ^ inner ^ "  " ^ elem_bind ^ "\n"
         ^ body_str
         ^ inner ^ "  " ^ idx_var ^ " := !" ^ idx_var ^ " + 1;\n"
         ^ inner ^ "done")
        (update st idx_var (VInt 0))

  (* for_code_state_coherent: follows directly from for_code_init_semantics +
   * the ensures of handle_for_init (update st idx_var (VInt 0)).
   * Full semantic WP equivalence is PROVED by wp_for_desugar
   * (Phase5c_WpForDesugar.v, 0 Admitted). *)
  lemma for_code_state_coherent :
    forall idx_var len_str elem_bind body_str inv_str var_str indent inner st.
    let code = handle_for_code idx_var len_str elem_bind body_str inv_str var_str indent inner in
    eval_whyml_stmts code st
    = eval_whyml_stmts
        (inner ^ "while !" ^ idx_var ^ " < " ^ len_str ^ " do\n"
         ^ inv_str ^ var_str
         ^ inner ^ "  " ^ elem_bind ^ "\n"
         ^ body_str
         ^ inner ^ "  " ^ idx_var ^ " := !" ^ idx_var ^ " + 1;\n"
         ^ inner ^ "done")
        (update st idx_var (VInt 0))

  (* ── field-assign / field-aug / slice-set / expr-stmt ─────────────────────────
   * Promoted to the SAME tier as the 10 control-flow/core arms: an emitter spec
   * (the emitted string shape) + an ATOMIC eval-semantics axiom (eval of that
   * literal string = the construct's effect) + a PROVED coherence lemma. The
   * effect is abstract (faithful: "field/slice/call changes state somehow"; what
   * it TRACKS is Phase 7/array-slice/Phase 8 future work). The coherence proof is
   * what catches an emitter bug (a wrong emitted string would not discharge). *)

  (* value-level binary op (a primitive, like the int/bitwise ops elsewhere) — used
   * only to give field-aug a CONCRETE read-modify-write effect. *)
  val function vop (op_str: string) (a b: value) : value

  (* array region fill: `slice_blit a lo hi vv` sets indices [lo,hi) to vv,
   * leaving the rest of `a` unchanged. Extensionally DEFINED by its get-behaviour
   * (so it is interpreted, not abstract). *)
  function slice_blit (a: M.map int int) (lo hi vv: int) : M.map int int
  axiom slice_blit_get :
    forall a lo hi vv i.
      M.get (slice_blit a lo hi vv) i = (if lo <= i /\ i < hi then vv else M.get a i)

  (* field-assign: `obj.fld <- val` *)
  val function handle_field_assign_code (obj fld ev indent rest_str : string) : string
    ensures { result = indent ^ obj ^ "." ^ fld ^ " <- " ^ ev ^ ";\n" ^ rest_str }
  function field_effect (st: state) (obj fld: string) (v: value) : state =
    update st (obj ^ "." ^ fld) v
  axiom field_assign_semantics :
    forall obj fld ev indent rest_str st e_val.
    eval_whyml_expr ev st = e_val ->
    eval_whyml_stmts (indent ^ obj ^ "." ^ fld ^ " <- " ^ ev ^ ";\n" ^ rest_str) st
    = eval_whyml_stmts rest_str (field_effect st obj fld e_val)
  lemma field_assign_code_state_coherent :
    forall obj fld ev indent rest_str st e_val.
    eval_whyml_expr ev st = e_val ->
    eval_whyml_stmts (handle_field_assign_code obj fld ev indent rest_str) st
    = eval_whyml_stmts rest_str (field_effect st obj fld e_val)

  (* The concrete effect now supports EFFECT-DEPENDENT reasoning (was impossible
   * with the abstract effect): after `obj.fld <- v`, the field reads back as v. *)
  lemma field_read_back :
    forall st obj fld v. lookup (field_effect st obj fld v) (obj ^ "." ^ fld) = v


  (* field-aug: `obj.fld <- obj.fld op val` *)
  val function handle_field_aug_code (obj fld op_str ev indent rest_str : string) : string
    ensures { result = indent ^ obj ^ "." ^ fld ^ " <- " ^ obj ^ "." ^ fld ^ " " ^ op_str ^ " " ^ ev ^ ";\n" ^ rest_str }
  function field_aug_effect (st: state) (obj fld op_str: string) (v: value) : state =
    update st (obj ^ "." ^ fld) (vop op_str (lookup st (obj ^ "." ^ fld)) v)
  axiom field_aug_semantics :
    forall obj fld op_str ev indent rest_str st e_val.
    eval_whyml_expr ev st = e_val ->
    eval_whyml_stmts (indent ^ obj ^ "." ^ fld ^ " <- " ^ obj ^ "." ^ fld ^ " " ^ op_str ^ " " ^ ev ^ ";\n" ^ rest_str) st
    = eval_whyml_stmts rest_str (field_aug_effect st obj fld op_str e_val)
  lemma field_aug_code_state_coherent :
    forall obj fld op_str ev indent rest_str st e_val.
    eval_whyml_expr ev st = e_val ->
    eval_whyml_stmts (handle_field_aug_code obj fld op_str ev indent rest_str) st
    = eval_whyml_stmts rest_str (field_aug_effect st obj fld op_str e_val)

  (* slice-set: `arr[lo:hi] <- val` (int-valued bounds/value) *)
  val function handle_slice_set_code (arr lo_str hi_str val_str indent rest_str : string) : string
    ensures { result = indent ^ arr ^ "[" ^ lo_str ^ ":" ^ hi_str ^ "] <- " ^ val_str ^ ";\n" ^ rest_str }
  function slice_effect (st: state) (arr: string) (lo hi vv: int) : state =
    update st arr (VArray (slice_blit (match lookup st arr with VArray a -> a | _ -> MC.const 0 end) lo hi vv))
  axiom slice_set_semantics :
    forall arr lo_str hi_str val_str indent rest_str st lo hi vv.
    eval_whyml_expr lo_str st = VInt lo ->
    eval_whyml_expr hi_str st = VInt hi ->
    eval_whyml_expr val_str st = VInt vv ->
    eval_whyml_stmts (indent ^ arr ^ "[" ^ lo_str ^ ":" ^ hi_str ^ "] <- " ^ val_str ^ ";\n" ^ rest_str) st
    = eval_whyml_stmts rest_str (slice_effect st arr lo hi vv)
  lemma slice_set_code_state_coherent :
    forall arr lo_str hi_str val_str indent rest_str st lo hi vv.
    eval_whyml_expr lo_str st = VInt lo ->
    eval_whyml_expr hi_str st = VInt hi ->
    eval_whyml_expr val_str st = VInt vv ->
    eval_whyml_stmts (handle_slice_set_code arr lo_str hi_str val_str indent rest_str) st
    = eval_whyml_stmts rest_str (slice_effect st arr lo hi vv)

  (* effect-dependent: after `arr[lo:hi] <- vv`, every index in [lo,hi) reads vv. *)
  lemma slice_read_in_range :
    forall st arr lo hi vv i. lo <= i < hi ->
    match lookup (slice_effect st arr lo hi vv) arr with
    | VArray a -> M.get a i = vv
    | _ -> true
    end

  (* expr-stmt (SCall): `let _ = call in ...` *)
  val function handle_expr_code (call_str indent rest_str : string) : string
    ensures { result = indent ^ "let _ = " ^ call_str ^ " in\n" ^ rest_str }
  (* a generic value-returning call with its result discarded does not mutate the
   * tracked state (mutating `.append`/`.add`/`.discard` are SEPARATE array/map ops,
   * modeled by arrayset/dict-update); so a discarded generic call is the identity. *)
  function expr_effect (st: state) (call_str: string) : state = st
  axiom expr_stmt_semantics :
    forall call_str indent rest_str st.
    eval_whyml_stmts (indent ^ "let _ = " ^ call_str ^ " in\n" ^ rest_str) st
    = eval_whyml_stmts rest_str (expr_effect st call_str)
  lemma expr_code_state_coherent :
    forall call_str indent rest_str st.
    eval_whyml_stmts (handle_expr_code call_str indent rest_str) st
    = eval_whyml_stmts rest_str (expr_effect st call_str)

end

(* ── PyCSL_WP_Compose ─────────────────────────────────────────────────────────
 * FINISH LINK 3: compose the per-arm coherence lemmas into a PROGRAM-LEVEL
 * theorem. Over a stmt_ir ADT with a CPS emitter (each statement embeds the
 * emission of the rest, mirroring _stmts_to_whyml's rest-threading), prove by
 * structural induction that evaluating the emitted code equals the WP state
 * transformer for the whole statement list — turning the 10 per-arm facts into
 * one whole-program coherence theorem `emit_stmts_coherent`.
 *)
module PyCSL_WP_Compose
  use int.Int
  use map.Map as M
  use map.Const as MC
  use list.List
  use string.String
  use PyCSL_WP_Spec
  use PyCSL_WP_Code
  use PyCSL_WP_Coherence

  (* Abstract expression IR + its emission/evaluation, tied by an audited
   * expression-coherence axiom (the expr-level peer of the eval_*_semantics). *)
  type expr_ir
  val function emit_expr (e: expr_ir) : string
  val function eval_e (e: expr_ir) (st: state) : value
  axiom expr_coherent : forall e st. eval_whyml_expr (emit_expr e) st = eval_e e st

  (* Separate abstract int-evaluator; `eval_e e st = VInt (eval_int e st)` is
   * NON-looping (eval_int does not mention eval_e), unlike `VInt (vint (eval_e ...))`.
   * Gives arrayset's index/value the VInt form the array_set lemma needs. *)
  val function eval_int (e: expr_ir) (st: state) : int
  axiom eval_e_int : forall e st. eval_e e st = VInt (eval_int e st)

  (* The PROVEN fragment: straight-line (skip/assign) + early-exit terminators
   * (return/continue). The whole-program composition theorem below is discharged
   * by structural induction over this fragment. *)
  type stmt =
    | St_skip
    | St_assign  ident expr_ir
    | St_arrset  ident expr_ir expr_ir
    | St_return  expr_ir
    | St_continue

  function wp_stmts (ss: list stmt) (st: state) : state =
    match ss with
    | Nil         -> st
    | Cons s rest ->
        match s with
        | St_return e   -> update st "\\result" (eval_e e st)
        | St_continue   -> st
        | St_skip       -> wp_stmts rest st
        | St_assign x e -> wp_stmts rest (update st x (eval_e e st))
        | St_arrset arr i v -> wp_stmts rest (arr_set_state st arr (eval_int i st) (eval_int v st))
        end
    end

  function emit_stmts (ss: list stmt) (indent: string) : string =
    match ss with
    | Nil         -> handle_skip_code indent ""
    | Cons s rest ->
        match s with
        | St_return e   -> handle_return_code (emit_expr e) indent false
        | St_continue   -> handle_continue_code indent
        | St_skip       -> handle_skip_code indent (emit_stmts rest indent)
        | St_assign x e -> handle_assign_code x (emit_expr e) indent (emit_stmts rest indent) true
        | St_arrset arr i v -> handle_array_set_code arr (emit_expr i) (emit_expr v) indent (emit_stmts rest indent)
        end
    end

  (* FINISH LINK 3 — whole-program composition theorem. Evaluating the emitted
   * WhyML for a statement list equals the WP state transformer, by structural
   * induction, each step discharged by the per-arm coherence lemma (+ expr_coherent). *)
  let rec lemma emit_stmts_coherent (ss: list stmt) (st: state) (indent: string)
    ensures { eval_whyml_stmts (emit_stmts ss indent) st = wp_stmts ss st }
    variant { ss }
  = match ss with
    | Nil -> ()
    | Cons s rest ->
        match s with
        | St_return _   -> ()
        | St_continue   -> ()
        | St_skip       -> emit_stmts_coherent rest st indent
        | St_assign x e -> emit_stmts_coherent rest (update st x (eval_e e st)) indent
        | St_arrset arr i v ->
            assert { eval_whyml_expr (emit_expr i) st = VInt (eval_int i st) };
            assert { eval_whyml_expr (emit_expr v) st = VInt (eval_int v st) };
            emit_stmts_coherent rest (arr_set_state st arr (eval_int i st) (eval_int v st)) indent
        end
    end

  (* ── if / while composition — CLOSED IN ROCQ; arrset DONE in Why3 ──────────
   * PROVED-COMPOSED in Why3 (emit_stmts_coherent above): skip, assign, ARRSET,
   * return, continue. arrset was cracked with a separate abstract `eval_int`
   * (non-looping int-typedness) + focused asserts + the named `arr_set_state`.
   *
   * if / while: the composition times out in Z3 4.13.3 here (string-theory
   * explosion on the handle_if_code/handle_while_code templates spliced with seq),
   * so it is CLOSED IN ROCQ instead — src/formal-semantics/rocq/Phase6L_ComposeIfWhile.v,
   * theorem `emit_stmts_coherent`, proves exactly this composition (if INSIDE a
   * `simple` fragment with `Sk_seq` blocks, and while) by structural induction in
   * <40 lines of explicit rewriting (Rocq rewrites step-by-step; no E-matching).
   * `Print Assumptions` confirms its only axioms are the per-arm `*_coh` facts —
   * i.e. THESE Why3-proved `*_code_state_coherent` lemmas — plus the abstract
   * interface; 0 Admitted. The if/while composition is therefore proved, audited by
   * Rocq, with the per-arm lemmas (proved here in Why3) as the shared trust base.
   * (issue #74). *)

  (* ── String <-> stmt_ir bridge to LINK 2's Rocq emitter (item 3) — AUDITED ────
   * `emit_stmts` above is the WHY3-side emitter. LINK 2 (bin/extraction-byte-diff.sh)
   * validates the ROCQ-extracted `emit_stmt_full_complete : stmt -> string` against
   * the Python emitter byte-for-byte (26 cases, 0 diffs). The correspondence between
   * the Why3 `emit_stmts` and the Rocq `emit_stmt_full_complete` is AUDITED on that
   * empirical byte-diff basis (proving it needs cross-prover extraction equivalence,
   * out of scope). It is recorded as prose rather than a Why3 axiom: stating it as
   * `forall ss. rocq_emit ss = emit_stmts ss` makes Z3 expand the recursive
   * `emit_stmts` during search and times out the composition proof. The trust basis
   * is documented in arm-coverage.md and is bin/extraction-byte-diff.sh. *)

end
