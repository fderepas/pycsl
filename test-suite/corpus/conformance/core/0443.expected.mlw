module PyCSL_Program
  use int.Int
  use int.EuclideanDivision
  use ref.Ref

  type sub = { mutable sub_size: int; mutable cap: int }
    invariant { (sub_size >= 0) }
    invariant { (cap >= 0) }
    by { sub_size = 0; cap = 5 }

  goal _check_class_inv_sub : forall sub_size cap : int. sub_size = 0 -> cap = 5 -> ((sub_size >= 0)) /\ ((cap >= 0))

  type store = { mutable store_size: int }
    invariant { (store_size >= 0) }
    by { store_size = 0 }

  goal _check_class_inv_store : forall store_size : int. store_size = 0 -> ((store_size >= 0))

  val store__count (self: store) : int
    ensures  { (result = self.store_size) }

  val sub__count (self: sub) : int
    ensures  { (result = self.sub_size) }

  let sub__room (self: sub) : int
    ensures  { (result >= 0) } (* linear *)
    ensures  { self.cap = old self.cap }
    ensures  { self.sub_size = old self.sub_size }
  =
    (self.cap + self.sub_size)

end