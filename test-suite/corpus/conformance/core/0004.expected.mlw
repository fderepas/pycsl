module PyCSL_Program
  use int.Int
  use int.EuclideanDivision
  use ref.Ref

  let test_loop_invariant (n: int) : int
    requires { (n >= 0) }
    ensures  { (result = (let __fd = (n * (n - 1)) in let __fr = 2 in if mod __fd __fr <> 0 && __fr < 0 then div __fd __fr - 1 else div __fd __fr)) }
  =
    let s = ref 0 in
    let i = ref 0 in
    s := 0;
    i := 0;
    while (!i < n) do
      invariant { (!s = (let __fd = (!i * (!i - 1)) in let __fr = 2 in if mod __fd __fr <> 0 && __fr < 0 then div __fd __fr - 1 else div __fd __fr)) }
      invariant { ((0 <= !i) && (!i <= n)) }
      variant { (n - !i) }
      s := (!s + !i);
      i := (!i + 1)
    done;
    !s

end