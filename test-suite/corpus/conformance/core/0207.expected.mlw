module PyCSL_Program
  use int.Int
  use int.EuclideanDivision
  use ref.Ref

  let count_to_n (n: int) : int
    requires { (n >= 0) }
    ensures  { (result = n) } (* linear *)
  =
    let i = ref 0 in
    i := 0;
    let ghost count = ref 0 in
    ghost count := 0;
    while (!i < n) do
      invariant { ((0 <= !i) && (!i <= n)) }
      invariant { (!count = !i) }
      variant { (n - !i) }
      ghost count := !count + 1;
      i := (!i + 1)
    done;
    !i

end