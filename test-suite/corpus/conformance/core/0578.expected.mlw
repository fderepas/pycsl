module PyCSL_Program
  use int.Int
  use int.EuclideanDivision
  use ref.Ref

  type account = { mutable balance: int }
    invariant { (balance >= 0) }
    by { balance = 0 }

  let acc : account = { balance = 0 }

  let account__deposit (self: account) (amount: int) : unit
    requires { (amount >= 0) }
    ensures  { (self.balance = ((old self.balance) + amount)) }
  =
    self.balance <- self.balance + amount

  let do_deposit (amount: int) : unit
    requires { (amount >= 0) }
    ensures  { (acc.balance = ((old acc.balance) + amount)) }
  =
    acc.balance <- acc.balance + amount

end