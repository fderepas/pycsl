module PyCSL_Program
  use int.Int
  use int.EuclideanDivision
  use ref.Ref

  type account = { mutable balance: int }
    invariant { (balance >= 0) }
    by { balance = 0 }

  goal _check_class_inv_account : forall balance : int. balance = 0 -> ((balance >= 0))

  let acc : account = { balance = 0 }

  let peek () : int
    ensures  { (result = (acc.balance + 1)) }
  =
    acc.balance

end