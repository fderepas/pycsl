(* set-model SMT-feasibility spike.

   FEATURE: a module-level constant string-set literal
     ROCQ_KERNEL_AXIOM_ALLOWLIST = {"propext", "Classical.choice", "Quot.sound"}
   read via `x in ROCQ_KERNEL_AXIOM_ALLOWLIST` lowers FAITHFULLY to a disjunction of
   string equalities (the named constant expanded to its literal, EXACTLY as the
   inline set-display `x in {"a", "b"}` already lowers):

       mem_allowlist x = (x = "propext" || x = "Classical.choice" || x = "Quot.sound")

   The disjunction is a total `bool` over `string` operands; NO new axiom, NO
   `string.String` extensionality (only literal disequality of distinct string
   constants). Must discharge on Z3 (Alt-Ergo lacks a string theory for the miss /
   fall-through disequalities — documented per-goal, the sanctioned best-of-N path).

   Target laws:
     (HIT)  mem_allowlist "propext" = True           -- a member returns true
     (MISS) mem_allowlist "no_such_axiom" = False     -- a non-member returns false
   plus a FALSE-TWIN goal (below) that must NOT prove on EITHER prover. *)

(* -- Section 1: the disjunction lowering that the emitter actually emits. -------- *)
module ConstSetMem
  use string.String
  use bool.Bool

  (* Faithful disjunction lowering of `x in ROCQ_KERNEL_AXIOM_ALLOWLIST`. *)
  function mem_allowlist (x: string) : bool =
    x = "propext" || x = "Classical.choice" || x = "Quot.sound"

  (* HIT: each element of the set is a member. *)
  goal g_hit_propext : mem_allowlist "propext" = True
  goal g_hit_choice  : mem_allowlist "Classical.choice" = True
  goal g_hit_quot    : mem_allowlist "Quot.sound" = True

  (* MISS: a string that is not one of the three literals is a non-member. Needs
     literal disequality of distinct string constants — Z3's string theory decides
     it; Alt-Ergo (no string theory) cannot, hence best-of-N. *)
  goal g_miss        : mem_allowlist "no_such_axiom" = False
  goal g_miss_close  : mem_allowlist "propex" = False
end

(* -- Section 2: Fset semantic grounding — the disjunction is exactly `Fset.mem`
      of the literal set built from the three string constants. This anchors the
      lowering in Why3's pure finite-set theory (no new axiom). ------------------- *)
module ConstSetFsetModel
  use string.String
  use bool.Bool
  use set.Fset

  (* The literal Fset built from the three allow-list string constants. *)
  function allowlist : fset string =
    add "propext" (add "Classical.choice" (add "Quot.sound" (empty : fset string)))

  (* The emitted disjunction and pure-set membership agree pointwise: on a hit the
     disjunction is true AND `Fset.mem` holds; on a miss both are false. (The fully
     universal equivalence needs string extensionality no SMT prover automates — the
     concrete agreements below are what ground the model; NO new axiom.) *)
  goal g_hit_agree  : ("propext" = "propext" || "propext" = "Classical.choice"
                       || "propext" = "Quot.sound") && mem "propext" allowlist
  goal g_miss_agree : not ("no_such_axiom" = "propext"
                           || "no_such_axiom" = "Classical.choice"
                           || "no_such_axiom" = "Quot.sound")
                      && not (mem "no_such_axiom" allowlist)
end

(* -- SOUNDNESS floor: these goals are FALSE of the real set and must NOT be Valid
      on ANY prover. A Valid here is a severity-1 regression (a false twin proven =>
      UNSOUND => the membership lowering is wrong). ----------------------------- *)
module ConstSetMemFalseTwins
  use string.String
  use bool.Bool

  function mem_allowlist (x: string) : bool =
    x = "propext" || x = "Classical.choice" || x = "Quot.sound"

  (* FALSE: "no_such_axiom" is NOT in the set, so membership is false, not true. *)
  goal g_miss_wrong : mem_allowlist "no_such_axiom" = True
  (* FALSE: "propext" IS in the set, so membership is true, not false. *)
  goal g_hit_wrong  : mem_allowlist "propext" = False
end
