module PyCSL_Program
  use int.Int
  use int.EuclideanDivision
  use ref.Ref
  use array.Array


  (* Abstract operations for unsupported Python patterns *)
  val constant i : int
  val constant k : int

  let find_compress (parent: array int) (x: int) (n: int) : int
    requires { (n >= 0) }
    requires { ((length parent) >= n) }
    requires { ((0 <= x) && (x < n)) }
    requires { (forall i : int. (((0 <= i) && (i < n)) -> ((0 <= parent[i]) && (parent[i] < n)))) }
    requires { (forall i : int. (((0 <= i) && (i < n)) -> (parent[i] <= i))) }
    ensures  { ((0 <= result) && (result < n)) }
    ensures  { (result <= x) }
    ensures  { (parent[result] = result) }
    ensures  { (parent[x] = result) }
    ensures  { (forall i : int. (((0 <= i) && (i < n)) -> ((0 <= parent[i]) && (parent[i] < n)))) }
    ensures  { (forall i : int. (((0 <= i) && (i < n)) -> (parent[i] <= i))) }
    ensures  { (forall k : int. (((0 <= k) && (k < result)) -> (parent[k] = (old parent[k])))) }
    ensures  { (forall k : int. ((((0 <= k) && (k < n)) && ((old parent[k]) = k)) -> (parent[k] = k))) }
  =
    let r = ref 0 in
    let nxt = ref 0 in
    let cur = ref 0 in
    r := x;
    while (parent[!r] <> !r) do
      invariant { ((0 <= !r) && (!r < n)) }
      invariant { (!r <= x) }
      invariant { (forall i : int. (((0 <= i) && (i < n)) -> (parent[i] = (old parent[i])))) }
      variant { !r }
      r := parent[!r]
    done;
    cur := x;
    while (parent[!cur] <> !r) do
      invariant { ((0 <= !r) && (!r < n)) }
      invariant { (parent[!r] = !r) }
      invariant { ((!r <= !cur) && (!cur < n)) }
      invariant { (forall i : int. (((0 <= i) && (i < n)) -> ((0 <= parent[i]) && (parent[i] < n)))) }
      invariant { (forall i : int. (((0 <= i) && (i < n)) -> (parent[i] <= i))) }
      invariant { (forall k : int. (((0 <= k) && (k < !r)) -> (parent[k] = (old parent[k])))) }
      invariant { (forall k : int. ((((0 <= k) && (k < n)) && ((old parent[k]) = k)) -> (parent[k] = k))) }
      variant { (!cur - !r) }
      nxt := parent[!cur];
      parent[!cur] <- !r;
      cur := !nxt
    done;
    !r

  let link_roots (parent: array int) (rx: int) (ry: int) (n: int) : int
    requires { (n >= 0) }
    requires { ((length parent) >= n) }
    requires { ((0 <= rx) && (rx < n)) }
    requires { ((0 <= ry) && (ry < n)) }
    requires { (forall i : int. (((0 <= i) && (i < n)) -> ((0 <= parent[i]) && (parent[i] < n)))) }
    requires { (forall i : int. (((0 <= i) && (i < n)) -> (parent[i] <= i))) }
    requires { (parent[rx] = rx) }
    requires { (parent[ry] = ry) }
    ensures  { ((0 <= result) && (result < n)) }
    ensures  { (parent[result] = result) }
    ensures  { ((result <= rx) && (result <= ry)) }
    ensures  { (forall i : int. (((0 <= i) && (i < n)) -> ((0 <= parent[i]) && (parent[i] < n)))) }
    ensures  { (forall i : int. (((0 <= i) && (i < n)) -> (parent[i] <= i))) }
    ensures  { (forall k : int. (((((0 <= k) && (k < n)) && (k <> rx)) && (k <> ry)) -> (parent[k] = (old parent[k])))) }
  =
    if (rx < ry) then begin
      parent[ry] <- rx;
      rx
    end else begin
      parent[rx] <- ry;
      ry
    end

end