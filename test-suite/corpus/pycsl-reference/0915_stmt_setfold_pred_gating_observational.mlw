module WallStmtSetFoldPredGatingObservation
  use int.Int
  use bool.Bool
  use list.List
  use option.Option
  use string.String
  use map.Map
  use map.Const

  (* self-tcb-reduction (method-call-guard extension): OBSERVATIONAL non-vacuity
     for the G-set-accumulate stmt-tree Set[str] fold recognizer extended to
     accept a METHOD-CALL guard `self._rhs_yields_map(val)` (converts
     `_collect_dict_var_assigns`
       (`found=set(); for s in stmts:
            if s.get("stmt")=="Assign":
                val=s.get("value",{})
                if isinstance(val,dict) and self._rhs_yields_map(val):
                    tgt=s.get("target",""); if tgt: found.add(tgt)
            for k in ("body","orelse"): if k in s: found |= self(s[k])
            if s.get("stmt")=="Try": for h in s.get("handlers",[]): found |= self(h.get("body",[]))
        return found`)).

     The `pyval`/`pydict`/`irkey`/`pv_size` theory and the `get_stmt`/`get_value`/
     `get_target`/`pre`/walk group below are VERBATIM the PyCSL tool's emitted
     output (module6_whyml/preamble.py::`_pydict_theory_lines` + the set
     `set_add`/`set_union` algebra, and generic_fold.py::`emit_stmt_setfold_group`
     with a `preds=["_rhs_yields_map"]` add-arm), modulo the per-method name
     mangling (short names here). TWO grounds make the gating OBSERVABLE (both are
     the FAITHFUL model of a `val` the tool leaves unconstrained):
       * `pystr_eq` -> string equality (`=`), the guard's payload test;
       * `rhs_yields_map` -> a CONCRETE gate (true iff the value pydict carries a
         `K_dyn "map"` marker cell) — the opaque predicate is uninterpreted in the
         tool (a boundary reader, NOT an axiom); grounding it as a specific total
         function is what lets us OBSERVE that it genuinely gates membership.
     No new constructor, no new axiom. *)

  type irkey = K_type | K_left | K_right | K_op | K_z
             | K_value | K_target | K_body | K_orelse | K_func | K_name
             | K_dyn string

  type pyval =
    | PInt  int
    | PStr  string
    | PBool bool
    | PNone
    | PList (list pyval)
    | PDict pydict
  with pydict =
    | DNil
    | DCons irkey pyval pydict

  (* the tool emits `val pystr_eq (a b: string) : bool` (unconstrained); the
     fixture grounds it as string equality — the faithful model of the guard. *)
  function pystr_eq (a b: string) : bool = a = b

  (* the tool emits `val set_add (m: map string bool) (e: string) : map string bool`
     with `ensures { result = Map.set m e true }`, and
     `let function set_union (a b) = fun k -> orb (Map.get a k) (Map.get b k)`. *)
  function set_add (m: map string bool) (e: string) : map string bool
    = Map.set m e true
  function set_union (a b: map string bool) : map string bool
    = fun (k: string) -> orb (Map.get a k) (Map.get b k)

  function pv_size (v: pyval) : int
  = match v with
    | PInt _ | PStr _ | PBool _ | PNone -> 1
    | PList xs -> 1 + size_list xs
    | PDict d  -> 1 + size_dict d
    end
  with size_list (l: list pyval) : int
  = match l with Nil -> 0 | Cons h t -> 1 + pv_size h + size_list t end
  with size_dict (d: pydict) : int
  = match d with DNil -> 0 | DCons _ v rest -> 1 + pv_size v + size_dict rest end

  (* ---- the OPAQUE self-predicate, GROUNDED so its gating is observable. ----
     The tool emits `val function rhs_yields_map (v: pyval) : bool` (a boundary
     reader, no axiom). Here it is a specific total function: true iff the value
     pydict carries a `K_dyn "map"` marker cell. A value the predicate REJECTS
     must not put its stmt's target into the set. *)
  function rhs_yields_map (v: pyval) : bool
  = match v with
    | PDict (DCons (K_dyn s) _ _) -> pystr_eq s "map"
    | _ -> false
    end

  (* ---- VERBATIM tool-emitted fold group (modulo name mangling). ---- *)
  function get_stmt (d: pydict) : option pyval
  = match d with
    | DNil -> None
    | DCons (K_dyn s) v rest -> if pystr_eq s "stmt" then Some v else get_stmt rest
    | DCons _ _ rest -> get_stmt rest
    end
  function get_value (d: pydict) : option pyval
  = match d with
    | DNil -> None
    | DCons K_value v _ -> Some v
    | DCons _ _ rest -> get_value rest
    end
  function get_target (d: pydict) : option pyval
  = match d with
    | DNil -> None
    | DCons K_target v _ -> Some v
    | DCons _ _ rest -> get_target rest
    end
  function pre (d: pydict) : map string bool
  = match get_stmt d with
    | Some (PStr tg0) ->
        if pystr_eq tg0 "Assign" then
          (match get_value d with
           | Some (PDict vd) ->
               if rhs_yields_map (PDict vd) then
                 (match get_target d with
                  | Some (PStr t) -> set_add (const false) t
                  | _ -> const false end)
               else const false
           | _ -> const false end)
        else const false
    | _ -> const false end
  function bld (stmts: list pyval) : map string bool
  = match stmts with
    | Nil -> const false
    | Cons h t -> set_union (bld_val h) (bld t)
    end
  with bld_val (v: pyval) : map string bool
  = match v with
    | PDict d -> set_union (pre d) (bld_dict d)
    | PList xs -> bld xs
    | _ -> const false
    end
  with bld_dict (d: pydict) : map string bool
  = match d with
    | DNil -> const false
    | DCons _ v rest -> set_union (bld_val v) (bld_dict rest)
    end

  (* an Assign stmt whose value the predicate ACCEPTS (value pydict has the
     K_dyn "map" marker) and whose target is "foo". *)
  function stmt_accept () : pyval
  = PDict (DCons (K_dyn "stmt") (PStr "Assign")
            (DCons K_value (PDict (DCons (K_dyn "map") PNone DNil))
              (DCons K_target (PStr "foo") DNil)))

  (* an Assign stmt whose value the predicate REJECTS (value pydict is empty,
     no marker) and whose target is "bar". *)
  function stmt_reject () : pyval
  = PDict (DCons (K_dyn "stmt") (PStr "Assign")
            (DCons K_value (PDict DNil)
              (DCons K_target (PStr "bar") DNil)))

  (* ==================================================================== *)
  (* OBSERVATIONAL non-vacuity — the predicate GENUINELY GATES membership.  *)
  (* ==================================================================== *)

  (* predicate-ACCEPTED value -> its target IS a member (real `set_add name`). *)
  let driver_accept () : unit =
    assert { Map.get (bld (Cons (stmt_accept ()) Nil)) "foo" = true }

  (* predicate-REJECTED value -> its target is ABSENT (the opaque guard fired
     false -> `const false`, no spurious entry, no int-placeholder). *)
  let driver_reject () : unit =
    assert { Map.get (bld (Cons (stmt_reject ()) Nil)) "bar" = false }

  (* EVIL TWIN 1 — the accepted target is NOT gated in: MUST stay UNPROVEN
     (if this proved, the fold would be vacuous / not really adding "foo"). *)
  let driver_evil_accept () : unit =
    assert { Map.get (bld (Cons (stmt_accept ()) Nil)) "foo" = false }

  (* EVIL TWIN 2 — the rejected target is spuriously in the set: MUST stay
     UNPROVEN (if this proved, the predicate would not be gating membership). *)
  let driver_evil_reject () : unit =
    assert { Map.get (bld (Cons (stmt_reject ()) Nil)) "bar" = true }

end
