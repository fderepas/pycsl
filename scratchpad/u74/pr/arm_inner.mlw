  val ext_str_encode_check_op (s: string) : unit raises { UnicodeEncodeError }
  val map_update_some (m: map 'k (option 'v)) (k: 'k) (v: 'v) : map 'k (option 'v)
    ensures { result = Map.set m k (Some v) }
  val function path_join_op (a b: string) : string
  predicate permut (a: array int) (b: array int)
  val real_hcarrier_op (x: real) : int
  val sorted_1 (a: array int) : array int
    ensures { Array.length result = Array.length a }
    ensures { forall _si : int. 0 <= _si < Array.length result - 1 ->
                result[_si] <= result[_si + 1] }
    ensures { permut result a }
  val str_concat_op (a: string) (b: string) : string
    ensures { result = (concat a b) }
