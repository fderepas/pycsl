  let _split_rocq_print_assumptions (stdout: string) (qualnames: array string) : map string (option string)
    requires { true }
    ensures  { true }
  =
    let block_starts_len = ref 0 in
    let start = ref 0 in
    let pos = ref 0 in
    let next_start = ref 0 in
    let markers = ref 0 in
    let marker = ref 0 in
    let idx = ref 0 in
    let py_end = ref 0 in
    let _for_target = ref 0 in
    let block_starts = ref Seq.empty in
    markers := (any int);
    pos := 0;
    try
    while (!pos < (str_length_op stdout)) do
      invariant { (0 <= !pos) }
      variant { ((String.length stdout) - !pos) }
      next_start := (- 1);
      let _seqlit_idx_marker = (Seq.cons "Closed under the global context" (Seq.cons "Axioms:" (Seq.cons "Section Variables:" (Seq.cons "Parameters:" (Seq.cons "Constants:" (Seq.empty: seq string)))))) in
      let _idx_marker = ref 0 in
      while !_idx_marker < (Seq.length _seqlit_idx_marker) do
        invariant { 0 <= !_idx_marker }
        variant { (Seq.length _seqlit_idx_marker) - !_idx_marker }
        invariant { ((!next_start = (- 1)) || (!next_start >= !pos)) }
        let marker = ref ((Seq.get _seqlit_idx_marker !_idx_marker)) in
        idx := (str_find_from_op stdout !marker !pos);
        if ((if (!idx <> (- 1)) && ((if (!next_start = (- 1)) || (!idx < !next_start) then 1 else 0) <> 0) then 1 else 0) <> 0) then begin
          next_start := !idx
        end;
        _idx_marker := !_idx_marker + 1
      done;
      if (!next_start = (- 1)) then begin
        raise PyCSL_Break
      end;
      block_starts := Seq.snoc !block_starts !next_start;
      pos := (!next_start + 1)
    done
    with PyCSL_Break -> () end;
    let py_result = ref (const (None: option string)) in
    let _seqlit_idx_marker = (Seq.cons "Closed under the global context" (Seq.cons "Axioms:" (Seq.cons "Section Variables:" (Seq.cons "Parameters:" (Seq.cons "Constants:" (Seq.empty: seq string)))))) in
    let _idx__for_target = ref 0 in
    while !_idx__for_target < (Array.length qualnames) do
      invariant { 0 <= !_idx__for_target }
      variant { (Array.length qualnames) - !_idx__for_target }
      try
        let i = ref !_idx__for_target in
        let qn = ref (qualnames[!_idx__for_target]) in
      if (!i >= (Seq.length !block_starts)) then begin
        py_result := map_update_some !py_result !qn "";
        raise PyCSL_Continue
      end;
      start := (Seq.get !block_starts !i);
      let py_end = ref (if ((!i + 1) < (Seq.length !block_starts)) then (Seq.get !block_starts (!i + 1)) else (str_length_op stdout)) in
      py_result := map_update_some !py_result !qn (str_sub_op stdout !start ((!py_end) - (!start)))
      with PyCSL_Continue -> () end;
      _idx__for_target := !_idx__for_target + 1
    done;
    !py_result

  let _to_cache_payload (report: reverifyreport) : map string (option hval)
    requires { true }
    ensures  { true }
  =
