    (map_update_some (map_update_some (map_update_some (map_update_some (map_update_some (const (None: option hval)) "compile_ok" (HInt report.compile_ok)) "compile_stdout" (HStr report.compile_stdout)) "compile_stderr" (HStr report.compile_stderr)) "elapsed_compile_s" (HInt (real_hcarrier_op report.elapsed_compile_s))) "qualname_results" (HArr (let _u74s1 = report.qualname_results in let _u74a1 = ref HNil in for _u74i1 = Seq.length _u74s1 - 1 downto 0 do let (_u74x1_0, _u74x1_1, _u74x1_2) = Seq.get _u74s1 _u74i1 in _u74a1 := HCons (HArr (HCons (HStr _u74x1_0) (HCons (HInt _u74x1_1) (HCons (HArr (let _u74b1 = ref HNil in for _u74j1 = Seq.length _u74x1_2 - 1 downto 0 do absurd; _u74b1 := HCons (HStr (Seq.get _u74x1_2 _u74j1)) !_u74b1 done; !_u74b1)) HNil)))) !_u74a1 done; !_u74a1)))

