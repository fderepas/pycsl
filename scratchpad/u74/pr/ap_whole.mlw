module PyCSL_StrLit
  use int.Int
  use string.String
  function pystr_code (s: string) : int
  val function pystr_chr (n: int) : string
    ensures { 0 <= n < 256 -> String.length result = 1 /\ pystr_code result = n }
    ensures { (0 <= n < 32 \/ n = 34 \/ n = 92 \/ 126 < n < 256) -> (result <> " " /\ result <> "!" /\ result <> "#" /\ result <> "$" /\ result <> "%" /\ result <> "&" /\ result <> "'" /\ result <> "(" /\ result <> ")" /\ result <> "*" /\ result <> "+" /\ result <> "," /\ result <> "-" /\ result <> "." /\ result <> "/" /\ result <> "0" /\ result <> "1" /\ result <> "2" /\ result <> "3" /\ result <> "4" /\ result <> "5" /\ result <> "6" /\ result <> "7" /\ result <> "8" /\ result <> "9" /\ result <> ":" /\ result <> ";" /\ result <> "<" /\ result <> "=" /\ result <> ">" /\ result <> "?" /\ result <> "@" /\ result <> "A" /\ result <> "B" /\ result <> "C" /\ result <> "D" /\ result <> "E" /\ result <> "F" /\ result <> "G" /\ result <> "H" /\ result <> "I" /\ result <> "J" /\ result <> "K" /\ result <> "L" /\ result <> "M" /\ result <> "N" /\ result <> "O" /\ result <> "P" /\ result <> "Q" /\ result <> "R" /\ result <> "S" /\ result <> "T" /\ result <> "U" /\ result <> "V" /\ result <> "W" /\ result <> "X" /\ result <> "Y" /\ result <> "Z" /\ result <> "[" /\ result <> "]" /\ result <> "^" /\ result <> "_" /\ result <> "`" /\ result <> "a" /\ result <> "b" /\ result <> "c" /\ result <> "d" /\ result <> "e" /\ result <> "f" /\ result <> "g" /\ result <> "h" /\ result <> "i" /\ result <> "j" /\ result <> "k" /\ result <> "l" /\ result <> "m" /\ result <> "n" /\ result <> "o" /\ result <> "p" /\ result <> "q" /\ result <> "r" /\ result <> "s" /\ result <> "t" /\ result <> "u" /\ result <> "v" /\ result <> "w" /\ result <> "x" /\ result <> "y" /\ result <> "z" /\ result <> "{" /\ result <> "|" /\ result <> "}" /\ result <> "~") }
  val function pystr_cat (a b: string) : string
    ensures { result = String.concat a b }
end

module PyCSL_Program
  use PyCSL_StrLit
  use int.Int
  use int.EuclideanDivision
  use ref.Ref
  use string.String
  use real.RealInfix
  use real.FromInt
  use seq.Seq
  use map.Map
  use map.Const
  use option.Option
  use array.Array

  exception PyCSL_Continue

  exception PyCSL_Break

  exception Return int
  exception FileNotFoundError
  exception OSError
  exception UnicodeDecodeError

  let pycsl_div (x: int) (y: int) : int
    requires { [@expl:division by zero] y <> 0 }
    ensures { result = (if mod x y <> 0 && y < 0 then div x y - 1 else div x y) }
  = if mod x y <> 0 && y < 0 then div x y - 1 else div x y

  let pycsl_mod (x: int) (y: int) : int
    requires { [@expl:modulo by zero] y <> 0 }
    ensures { result = (if mod x y <> 0 && y < 0 then mod x y + y else mod x y) }
  = if mod x y <> 0 && y < 0 then mod x y + y else mod x y

  (* dict-value-model-r4: the FROZEN certified mixed-value theory (module DictR4Theory of getting-better/dict-r4-theory.mlw, verbatim; Rocq Phase2m_PyValR4.v + Lean PyCSL/PyValR4.lean). Route (e2): `pairs_get` is uninterpreted with its two certified defining equations (realised by the same-named axiom-free Rocq + Lean lemmas). Gated on `_uses_pyval`. *)
  use int.Int
  use real.RealInfix
  use real.FromInt
  use real.Truncate
  use option.Option
  use string.String
  type hval = HNone | HBool bool | HInt int | HFloat real | HStr string | HTuple hval_list | HArr hval_list | HMap hpairs | HNode hval
  with hval_list = HNil | HCons hval hval_list
  with hpairs = PNil | PCons string hval hpairs
  val function hpairs_key_eq (a b: string) : bool ensures { result <-> a = b }
  val function hstr_len (s: string) : int ensures { result = String.length s }
  val function hreal_eq (a b: real) : bool ensures { result <-> a = b }
  val function hreal_int_of (f: real) : option int
    ensures { result = if FromInt.from_int (truncate f) = f then Some (truncate f) else None }
  val function hval_opaque_str (h: hval) : string
  val function hval_opaque_int (h: hval) : int
  val function hval_len_other (h: hval) : int
  val function hval_tuple_other (h: hval) : hval
  val function pairs_get (p: hpairs) (k: string) : option hval
  axiom pairs_get_nil : forall k. pairs_get PNil k = None
  axiom pairs_get_cons : forall k k' v t [pairs_get (PCons k' v t) k].
    pairs_get (PCons k' v t) k = (if k = k' then Some v else pairs_get t k)
  let rec function pairs_set (p: hpairs) (k: string) (v: hval) : hpairs
    variant { p }
    = match p with
      | PNil -> PCons k v PNil
      | PCons k' w t -> if hpairs_key_eq k k' then PCons k' v t else PCons k' w (pairs_set t k v)
      end
  let function pairs_mem (p: hpairs) (k: string) : bool =
    match pairs_get p k with None -> false | Some _ -> true end
  let rec function hpairs_len (p: hpairs) : int
    variant { p }
    = match p with PNil -> 0 | PCons _ _ t -> 1 + hpairs_len t end
  let rec function pairs_nodup (p: hpairs) : bool
    variant { p }
    = match p with PNil -> true | PCons k _ t -> not (pairs_mem t k) && pairs_nodup t end
  let rec function pairs_keys_in (q p: hpairs) : bool
    variant { q }
    = match q with PNil -> true | PCons k _ t -> pairs_mem p k && pairs_keys_in t p end
  let rec function hpairs_keys (p: hpairs) : hval_list
    variant { p }
    = match p with PNil -> HNil | PCons k _ t -> HCons (HStr k) (hpairs_keys t) end
  let function hbool_int (b: bool) : int = if b then 1 else 0
  let rec function hval_eq (a b: hval) : bool
    variant { a }
    = match a with
      | HNone -> (match b with HNone -> true | _ -> false end)
      | HBool x -> (match b with
                    | HBool y -> (if x then y else not y)
                    | HInt j -> hbool_int x = j
                    | HFloat g -> (match hreal_int_of g with Some j -> hbool_int x = j | None -> false end)
                    | _ -> false end)
      | HInt i -> (match b with
                   | HBool y -> i = hbool_int y
                   | HInt j -> i = j
                   | HFloat g -> (match hreal_int_of g with Some j -> i = j | None -> false end)
                   | _ -> false end)
      | HFloat f -> (match b with
                     | HBool y -> (match hreal_int_of f with Some i -> i = hbool_int y | None -> false end)
                     | HInt j -> (match hreal_int_of f with Some i -> i = j | None -> false end)
                     | HFloat g -> hreal_eq f g
                     | _ -> false end)
      | HStr s -> (match b with HStr t -> hpairs_key_eq s t | _ -> false end)
      | HTuple l -> (match b with HTuple m -> hlist_eq l m | _ -> false end)
      | HArr l -> (match b with HArr m -> hlist_eq l m | _ -> false end)
      | HMap p -> (match b with HMap q -> pairs_incl p q && pairs_keys_in q p | _ -> false end)
      | HNode x -> (match b with HNode y -> hval_eq x y | _ -> false end)
      end
  with function hlist_eq (l m: hval_list) : bool
    variant { l }
    = match l with
      | HNil -> (match m with HNil -> true | _ -> false end)
      | HCons x t -> (match m with HCons y u -> hval_eq x y && hlist_eq t u | _ -> false end)
      end
  with function pairs_incl (p q: hpairs) : bool
    variant { p }
    = match p with
      | PNil -> true
      | PCons k v t -> (match pairs_get q k with Some w -> hval_eq v w | None -> false end)
                       && pairs_incl t q
      end
  let rec function hval_canon (v: hval) : hval
    variant { v }
    = match v with
      | HBool b -> HInt (hbool_int b)
      | HFloat f -> (match hreal_int_of f with Some i -> HInt i | None -> HFloat f end)
      | HTuple l -> HTuple (hlist_canon l)
      | _ -> v
      end
  with function hlist_canon (l: hval_list) : hval_list
    variant { l }
    = match l with HNil -> HNil | HCons x t -> HCons (hval_canon x) (hlist_canon t) end
  let rec function hval_hashable (v: hval) : bool
    variant { v }
    = match v with
      | HNone -> true | HBool _ -> true | HInt _ -> true | HFloat _ -> true | HStr _ -> true
      | HTuple l -> hlist_hashable l
      | _ -> false
      end
  with function hlist_hashable (l: hval_list) : bool
    variant { l }
    = match l with HNil -> true | HCons x t -> hval_hashable x && hlist_hashable t end
  let function hval_truthy (h: hval) : bool =
    match h with
    | HNone -> false
    | HBool b -> b
    | HInt i -> i <> 0
    | HFloat f -> not (hreal_eq f 0.0)
    | HStr s -> not (hpairs_key_eq s "")
    | HTuple l -> (match l with HNil -> false | _ -> true end)
    | HArr l -> (match l with HNil -> false | _ -> true end)
    | HMap p -> (match p with PNil -> false | _ -> true end)
    | HNode _ -> true
    end
  let function hstr_of (h: hval) : string =
    match h with HStr s -> s | _ -> hval_opaque_str h end
  let function hint_of (h: hval) : int =
    match h with HInt i -> i | HBool b -> hbool_int b | _ -> hval_opaque_int h end
  let rec function hval_list_len (l: hval_list) : int
    variant { l }
    = match l with HNil -> 0 | HCons _ t -> 1 + hval_list_len t end
  let rec function hval_list_nth (l: hval_list) (i: int) : hval
    variant { l }
    = match l with
      | HNil -> HInt 0
      | HCons x t -> if i <= 0 then x else hval_list_nth t (i - 1)
      end
  let function hval_len (h: hval) : int =
    match h with
    | HStr s -> hstr_len s
    | HTuple l -> hval_list_len l
    | HArr l -> hval_list_len l
    | HMap p -> hpairs_len p
    | _ -> hval_len_other h
    end
  let function hval_tuple (h: hval) : hval =
    match h with
    | HTuple l -> HTuple l
    | HArr l -> HTuple l
    | HMap p -> HTuple (hpairs_keys p)
    | _ -> hval_tuple_other h
    end
  let rec function hval_list_snoc (l: hval_list) (x: hval) : hval_list
    variant { l }
    = match l with HNil -> HCons x HNil | HCons h t -> HCons h (hval_list_snoc t x) end
  (* r3 views still called by the emitter, over the frozen type (not part of the DictR4Theory companion; definitional or law-free, no axiom): HTuple is a sequence like HArr, a dict's `in` is KEY membership (`pairs_mem`), and every other tag is the UNINTERPRETED `hval_in_other` / `hval_opaque_str` arm (TypeError / substring sites, never a concrete junk value). *)
  val function hval_in_other (k: string) (h: hval) : bool
  (* the RAISING arm of a PyVal read (an absent key: KeyError; a non-dict receiver: AttributeError / TypeError): a law-free value OF the receiver and the key -- uninterpreted (never a concrete junk value) and deterministic (two reads of one absent key agree). Dead in Python; asserted absent under a KeyError claim. *)
  val function hval_get_other (h: hval) (k: string) : hval
  let rec function hval_list_str_mem (l: hval_list) (x: string) : bool
    variant { l }
    = match l with
      | HNil -> false
      | HCons h t -> if (match h with HStr s -> hpairs_key_eq s x | _ -> false end) then true else hval_list_str_mem t x
      end
  let function hval_str_mem (h: hval) (x: string) : bool =
    match h with HArr l -> hval_list_str_mem l x | HTuple l -> hval_list_str_mem l x | HMap p -> pairs_mem p x | _ -> hval_in_other x h end
  let function hval_nth_str (h: hval) (i: int) : string =
    match h with HArr l -> hstr_of (hval_list_nth l i) | HTuple l -> hstr_of (hval_list_nth l i) | _ -> hval_opaque_str h end
  val function hval_values_len (m: map string (option hval)) : int
  val function hval_values_get (m: map string (option hval)) (i: int) : hval
  val function hval_keys_get (m: map string (option hval)) (i: int) : string
  val function hval_as_map (h: hval) : map string (option hval)

  (* set-value-model-wall (self-tcb-reduction, Tier-5 value-model wall): the EXECUTABLE emitter-local `Set[str]` value model — a `set.SetApp` clone over `string`. Nested `scope` so `empty`/`add`/`mem`/`set` do NOT collide with list.Mem/list.Append in the flat program module. Proven axiom-free by getting-better/set-oracle.mlw (Z3 Valid). `eq_str` is a decidable program string-equality PRIMITIVE (Python `==`), NOT a project axiom — its refinement VC discharges. `set.SetApp`/`set.Fset` are trusted Why3 stdlib (NOT `_AXIOM_REGISTRY` entries) — the ledger stays 3. `set()`->`StrSet.empty ()`, `.add`->`StrSet.add`, `in`/`not in`->a PROGRAM BOOL `StrSet.mem`/`not StrSet.mem` guard; NO set-non-membership proof obligation is ever emitted (it times out). *)
  scope StrSet
    use string.String
    val eq_str (x y: string) : bool ensures { result <-> x = y }
    clone export set.SetApp with type elt = string, val eq = eq_str, axiom .
  end

  type auditreport = { mutable passes: array string; mutable failures: array string; mutable skips: array string }

  type _directive = { prover: string; qualname: string; py_file: int; line_no: int }


  (* Abstract operations for unsupported Python patterns *)
  val function path_join_op (a b: string) : string
  val function path_parent_op (s: string) : string
  val path_resolve_op (s: string) : string
  val function path_stem_op (s: string) : string
  val print_1 (x0: int) : int
  val function pycsl_none : int
  val function pycsl_none_str : string
  val report_extend_1 (self: auditreport) (x0: auditreport) : unit
    writes { self.failures, self.passes, self.skips }
  val str_concat (x: int) (y: int) : int
  val str_concat_op (a: string) (b: string) : string
    ensures { result = (concat a b) }
    ensures { String.length result = String.length a + String.length b }
  val str_eq_op (a: string) (b: string) : bool
    ensures { result <-> (a = b) }
  val str_join_seq (sep: string) (xs: seq string) : string
    ensures { String.length result >= 0 }
  val str_length_op (s: string) : int
    ensures { result = (String.length s) }
  val str_sub_op (s: string) (lo len: int) : string
    ensures { (0 <= lo /\ 0 <= len) -> result = (String.substring s lo len) }
    ensures { (0 <= lo /\ 0 <= len /\ lo + len <= String.length s) -> String.length result = len }
  val str_hash_op (s: string) : int

  let _strip_lean_comments (text: string) : string
    requires { true }
    ensures  { true }
  =
    let out_len = ref 0 in
    let n = ref 0 in
    let i = ref 0 in
    let depth = ref 0 in
    let out = ref Seq.empty in
    depth := 0;
    i := 0;
    n := (str_length_op text);
    while (!i < !n) do
      invariant { (!i >= 0) }
      variant { (!n - !i) }
      if ((if ((if ((if (!depth = 0) && ((!i + 1) < !n) then 1 else 0) <> 0) && (str_eq_op (str_sub_op text !i 1) "/") then 1 else 0) <> 0) && (str_eq_op (str_sub_op text (!i + 1) 1) "-") then 1 else 0) <> 0) then begin
        depth := 1;
        i := !i + 2
      end else begin
        if ((if ((if ((if (!depth > 0) && ((!i + 1) < !n) then 1 else 0) <> 0) && (str_eq_op (str_sub_op text !i 1) "/") then 1 else 0) <> 0) && (str_eq_op (str_sub_op text (!i + 1) 1) "-") then 1 else 0) <> 0) then begin
          depth := !depth + 1;
          i := !i + 2
        end else begin
          if ((if ((if ((if (!depth > 0) && ((!i + 1) < !n) then 1 else 0) <> 0) && (str_eq_op (str_sub_op text !i 1) "-") then 1 else 0) <> 0) && (str_eq_op (str_sub_op text (!i + 1) 1) "/") then 1 else 0) <> 0) then begin
            depth := !depth - 1;
            i := !i + 2
          end else begin
            if (!depth > 0) then begin
              i := !i + 1
            end else begin
              if ((if ((if ((!i + 1) < !n) && (str_eq_op (str_sub_op text !i 1) "-") then 1 else 0) <> 0) && (str_eq_op (str_sub_op text (!i + 1) 1) "-") then 1 else 0) <> 0) then begin
                label SKIP_EOL in
                while ((if (!i < !n) && (not (str_eq_op (str_sub_op text !i 1) (pystr_chr 10))) then 1 else 0) <> 0) do
                  invariant { (!i >= (!i at SKIP_EOL)) }
                  variant { (!n - !i) }
                  i := !i + 1
                done
              end else begin
                out := Seq.snoc !out (str_sub_op text !i 1);
                i := !i + 1
              end
            end
          end
        end
      end
    done;
    (str_join_seq "" !out)

  val _parse_lean_file (path: string) : map int (option int)
    requires { true }
    ensures  { true }

  let _strip_rocq_comments (text: string) : string
    requires { true }
    ensures  { true }
  =
    let out_len = ref 0 in
    let n = ref 0 in
    let i = ref 0 in
    let depth = ref 0 in
    let out = ref Seq.empty in
    depth := 0;
    i := 0;
    n := (str_length_op text);
    while (!i < !n) do
      invariant { (!i >= 0) }
      variant { (!n - !i) }
      if ((if ((if ((if (!depth = 0) && ((!i + 1) < !n) then 1 else 0) <> 0) && (str_eq_op (str_sub_op text !i 1) "(") then 1 else 0) <> 0) && (str_eq_op (str_sub_op text (!i + 1) 1) "*") then 1 else 0) <> 0) then begin
        depth := 1;
        i := !i + 2
      end else begin
        if ((if ((if ((if (!depth > 0) && ((!i + 1) < !n) then 1 else 0) <> 0) && (str_eq_op (str_sub_op text !i 1) "(") then 1 else 0) <> 0) && (str_eq_op (str_sub_op text (!i + 1) 1) "*") then 1 else 0) <> 0) then begin
          depth := !depth + 1;
          i := !i + 2
        end else begin
          if ((if ((if ((if (!depth > 0) && ((!i + 1) < !n) then 1 else 0) <> 0) && (str_eq_op (str_sub_op text !i 1) "*") then 1 else 0) <> 0) && (str_eq_op (str_sub_op text (!i + 1) 1) ")") then 1 else 0) <> 0) then begin
            depth := !depth - 1;
            i := !i + 2
          end else begin
            if (!depth = 0) then begin
              out := Seq.snoc !out (str_sub_op text !i 1);
              i := !i + 1
            end else begin
              i := !i + 1
            end
          end
        end
      end
    done;
    (str_join_seq "" !out)

  val _parse_rocq_file (path: string) : map int (option int)
    requires { true }
    ensures  { true }

  val _index_proofs_dir (proofs_dir: string) (prover: string) : map int (option int)
    requires { true }
