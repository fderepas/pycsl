  val verify_rocq_file (proof_file: string) (qualnames: array string) (project_root: string) (use_cache: int) : int
    requires { true }
    ensures  { true }

  val _audit_one_prover (py_file: string) (proofs_dir: string) (prover: string) (directives: array _directive) (reverify: int) (project_root: string) : auditreport
    requires { true }
    ensures  { true }

  let function _default_lean_dir (py_file: string) : string
    requires { true }
    ensures  { true }
  =
    (path_join_op (path_join_op (path_parent_op py_file) (str_concat_op (path_stem_op py_file) ".proofs")) "lean")

  let function _default_rocq_dir (py_file: string) : string
    requires { true }
    ensures  { true }
  =
    (path_join_op (path_join_op (path_parent_op py_file) (str_concat_op (path_stem_op py_file) ".proofs")) "rocq")

  val _extract_directives (py_file: string) : array _directive
    requires { true }
    ensures  { true }

  let audit_lean (py_file: string) (proofs_dir: string) (reverify: int) (project_root: string) : auditreport
    requires { true }
    ensures  { true }
  =
    let py_file = ref py_file in
    let proofs_dir = ref proofs_dir in
    py_file := (path_resolve_op !py_file);
    if (str_eq_op !proofs_dir pycsl_none_str) then begin
      proofs_dir := (_default_lean_dir !py_file)
    end;
    let directives = (_extract_directives !py_file) in
    (_audit_one_prover !py_file !proofs_dir "lean" directives reverify project_root)

  let audit_rocq (py_file: string) (proofs_dir: string) (reverify: int) (project_root: string) : auditreport
    requires { true }
    ensures  { true }
  =
    let py_file = ref py_file in
    let proofs_dir = ref proofs_dir in
    py_file := (path_resolve_op !py_file);
    if (str_eq_op !proofs_dir pycsl_none_str) then begin
      proofs_dir := (_default_rocq_dir !py_file)
    end;
    let directives = (_extract_directives !py_file) in
    (_audit_one_prover !py_file !proofs_dir "rocq" directives reverify project_root)

  let audit_both (py_file: string) (rocq_dir: string) (lean_dir: string) (reverify: int) (project_root: string) : auditreport
    requires { true }
    ensures  { true }
  =
    let report = { passes = (Array.make 0 ""); failures = (Array.make 0 ""); skips = (Array.make 0 "") } in
    let _ = (report_extend_1 report (audit_rocq py_file rocq_dir reverify project_root)) in ();
    let _ = (report_extend_1 report (audit_lean py_file lean_dir reverify project_root)) in ();
    report

  let auditreport__exit_code (self: auditreport) : int
    requires { true }
    ensures  { (((Array.length self.failures) > 0) -> (result = 1)) }
    ensures  { (((Array.length self.failures) = 0) -> (result = 0)) }
    ensures  { self.failures = old self.failures }
    ensures  { self.passes = old self.passes }
    ensures  { self.skips = old self.skips }
  =
    (if (Array.length (self.failures) <> 0) then 1 else 0)

  let auditreport__extend (self: auditreport) (other: auditreport) : unit
    requires { true }
