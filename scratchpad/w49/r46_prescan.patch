+                # opaque (the read site does that for every recorded name); the COMPARISON
+                # is refused in `_expr_to_whyml`.
+                self._erased_truthy_locals[_amb_nm] = "AMBIG#nan"
+            elif "NONE" in _amb_k:
+                self._erased_truthy_locals[_amb_nm] = "AMBIG"
