+def recognize_scan_node_for_subscript_calls(func: Dict[str, Any]) -> Optional[Dict[str, Any]]:
+    """Fail-closed match of `_scan_node_for_subscript_calls`. Never raises."""
+    try:
+        return _recognize_scan_node_for_subscript_calls(func)
+    except Exception:
+        return None
+
