  (* richer-contracts-bridge P2.1 (C2): DEEP well-formedness — the INDUCTIVE
     invariant of the recursive substitution (recurses into list elements AND
     dict values). Strengthens the certified shallow wf_ir; pure definition,
     NO axiom. The two lemmas prove it implies the certified wf_ir. *)
  predicate wf_ir_deep (v: pyval)
  = match v with
    | PDict d  -> wf_dict_deep d
    | PList xs -> wf_list_deep xs
    | _ -> true
    end
  with wf_dict_deep (d: pydict)
  = match d with
    | DNil -> true
    | DCons k v rest -> wf_val k v /\ wf_ir_deep v /\ wf_dict_deep rest
    end
  with wf_list_deep (xs: list pyval)
  = match xs with
    | Nil -> true
    | Cons h t -> wf_ir_deep h /\ wf_list_deep t
    end
  (* Bridge tie: the deep predicate strengthens the certified shallow wf_ir
     (Phase2c_PyValDict.v), so `ensures wf_ir_deep result` entails the audited
     wf_ir. Proved by structural induction — NO axiom. *)
  let rec lemma wf_dict_deep_shallow (d: pydict) : unit
    requires { wf_dict_deep d } ensures { wf_dict d } variant { d }
  = match d with DNil -> () | DCons _ _ rest -> wf_dict_deep_shallow rest end
  let lemma wf_ir_deep_shallow (v: pyval) : unit
    requires { wf_ir_deep v } ensures { wf_ir v }
  = match v with PDict d -> wf_dict_deep_shallow d | _ -> () end
  (* Lemma-pack fact for the string-key case: a value that stays a PStr
     whenever it was a PStr keeps wf_val for its key. `let lemma` (CALLED by
     the fold body => split-robust exact instantiation).
     PROOF-HARDENING (context-independent): under `split_vc` the ensures
     `wf_val k v2` splits into per-named-key sub-goals whose NEGATION
     skolemises v2 into PInt/PList/PDict witnesses; those constructor terms
     seed the recursive wf_dict / wf_ir_binds / size_dict E-matching in any
     polluted pyval context and the VC floods (370M+ steps => timeout).  The
     fix keeps the STATEMENT byte-identical and only makes the body explicit:
     (i) split each key so k is concrete; (ii) for the named keys case v2 on
     EVERY pyval constructor so each split sub-goal is discharged by a
     concrete-constructor branch (no free-var skolem, no seed) — the non-PStr
     v2 branches are `absurd` (req1 forces v PStr for a named key, then req2
     forces v2 PStr, so v2 non-PStr is genuinely unreachable: the requires are
     jointly satisfiable, e.g. k=K_left, so the lemma stays NON-VACUOUS);
     (iii) an arm-level `assert { wf_val k v2 }` (concrete k, surviving v2=PStr
     path) hands the merged generic-k postcondition goal its per-key fact so
     BOTH Alt-Ergo and Z3 close it in bounded steps.  Discharges << 1s / < 1M
     steps context-independently, versus the pre-hardening flood. *)
  let lemma wf_val_str_stable (k: irkey) (v v2: pyval) : unit
    requires { wf_val k v }
    requires { match v with PStr _ -> (match v2 with PStr _ -> true | _ -> false end) | _ -> true end }
    ensures  { wf_val k v2 }
  = match k with
    | K_op | K_type | K_target | K_func | K_name ->
        (match v2 with
         | PStr _ -> ()
         | _ -> (match v with PStr _ -> absurd | _ -> absurd end)
         end);
        assert { wf_val k v2 }
    | K_left | K_right | K_z | K_value | K_body | K_orelse | K_dyn _ -> ()
    end

  (* richer-contracts-bridge P2.3 (C2): emitted-fragment grammar membership
     (structural scope: no bare PNone sentinel). Bridge-audit predicate tying
     the method to evaluator-axiom-audit.md's boundary BY CONTRACT. NO axiom. *)
  predicate in_emitted_fragment (v: pyval)
  = match v with
    | PNone -> false
    | PInt _ | PStr _ | PBool _ -> true
    | PList xs -> frag_list xs
    | PDict d  -> frag_dict d
    end
  with frag_dict (d: pydict)
  = match d with
    | DNil -> true
    | DCons _ v rest -> in_emitted_fragment v /\ frag_dict rest
    end
  with frag_list (xs: list pyval)
  = match xs with
    | Nil -> true
    | Cons h t -> in_emitted_fragment h /\ frag_list t
    end

  (* proof-scale step-lemma (gated on BOTH wf_ir_deep + in_emitted_fragment
     families): one unfold of wf_dict_deep/frag_dict on a DCons with ABSTRACT
     k/v2/rest2; non-recursive `= ()`, so its own VC touches no
     size_dict/recursive pool.  CALLED in the __dict fold body to hand the
     prover the exact postcondition ground fact WITHOUT unfolding the
     recursive result — kills the polluted-pool E-matching flood.  NO axiom. *)
  let lemma dcons_wf_frag_step (k: irkey) (v2: pyval) (rest2: pydict) : unit
    requires { wf_val k v2 /\ wf_ir_deep v2 /\ in_emitted_fragment v2 }
    requires { wf_dict_deep rest2 /\ frag_dict rest2 }
    ensures  { wf_dict_deep (DCons k v2 rest2) /\ frag_dict (DCons k v2 rest2) }
  = ()
  let rec _subst_type_in_ir (node: pyval) (tvar: string) (concrete: string) : pyval
    requires { (wf_ir_deep node) } requires { (in_emitted_fragment node) } ensures { ((pv_size result) > 0) } ensures { (wf_ir_deep result) } ensures { (in_emitted_fragment result) } ensures { match node with PStr _ -> (match result with PStr _ -> true | _ -> false end) | _ -> true end }
    variant { pv_size node }
  = match node with
    | PList xs -> PList (_subst_type_in_ir__list xs tvar concrete)
    | PDict d  -> PDict (_subst_type_in_ir__dict d tvar concrete)
    | _ -> node end
  with _subst_type_in_ir__dict (d: pydict) (tvar: string) (concrete: string) : pydict
    requires { wf_dict_deep d /\ frag_dict d } ensures { wf_dict_deep result /\ frag_dict result }
    variant { size_dict d }
  = match d with
    | DNil -> DNil
    | DCons k v rest ->
        let v2 =
          match v with
          | PStr s -> if _subst_type_in_ir__triggers k && pystr_eq s tvar then PStr concrete
                      else _subst_type_in_ir v tvar concrete
          | _ -> _subst_type_in_ir v tvar concrete end
        in
        assert { match v with PStr _ -> (match v2 with PStr _ -> true | _ -> false end) | _ -> true end };
        wf_val_str_stable k v v2;
        assert { wf_ir_deep v2 };
        assert { in_emitted_fragment v2 };
        let rest2 = _subst_type_in_ir__dict rest tvar concrete in
        dcons_wf_frag_step k v2 rest2;
        DCons k v2 rest2
    end
  with _subst_type_in_ir__list (xs: list pyval) (tvar: string) (concrete: string) : list pyval
    requires { wf_list_deep xs /\ frag_list xs } ensures { wf_list_deep result /\ frag_list result }
    variant { size_list xs }
  = match xs with Nil -> Nil
    | Cons h t -> Cons (_subst_type_in_ir h tvar concrete) (_subst_type_in_ir__list t tvar concrete) end
  val apply_monomorphization (ir_data: int) (validated_ast: int) : unit
    requires { true }
    ensures  { true }

  val pycslerror____str__ (self: pycslerror) : string

  val pycslerror__as_dict (self: pycslerror) : map string (option hval)

  val pycslerror__message (self: pycslerror) : string

end