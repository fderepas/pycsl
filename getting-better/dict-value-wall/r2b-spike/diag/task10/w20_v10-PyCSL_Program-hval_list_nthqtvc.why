goal hval_list_nthqtvc [@expl:VC for hval_list_nth] :
  [@vc:annotation] [@expl:variant decrease] [@hyp_name:Variant]
  match [@hyp_name:Variant] l2 with
  | HNil -> false
  | HCons _ f -> f = ([@hyp_name:Variant] x9)
  end

end
