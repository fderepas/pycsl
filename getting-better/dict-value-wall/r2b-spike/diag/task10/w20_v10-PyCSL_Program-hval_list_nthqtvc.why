(* use int.Int *)

function abs (x:int) : int = if infix_gteq x 0 then x else prefix_mn x

axiom Abs_le :
  forall x:int, y:int.
   infix_lseq (abs x) y <-> infix_lseq (prefix_mn y) x /\ infix_lseq x y

(* meta remove_unused:dependency prop Abs_le, function abs *)

axiom Abs_pos : forall x:int. infix_gteq (abs x) 0

(* meta remove_unused:dependency prop Abs_pos, function abs *)

(* use int.Abs *)

function div int int : int

function mod int int : int

axiom Div_mod [@useraxiom] :
  forall x:int, y:int.
   not y = 0 -> x = infix_pl (infix_as y (div x y)) (mod x y)

(* meta remove_unused:dependency prop Div_mod, function div *)

(* meta remove_unused:dependency prop Div_mod, function mod *)

axiom Mod_bound [@useraxiom] :
  forall x:int, y:int.
   not y = 0 -> infix_lseq 0 (mod x y) /\ infix_ls (mod x y) (abs y)

(* meta remove_unused:dependency prop Mod_bound, function mod *)

axiom Div_unique :
  forall x:int, y:int, q:int.
   infix_gt y 0 ->
   infix_lseq (infix_as q y) x /\ infix_ls x (infix_pl (infix_as q y) y) ->
   div x y = q

(* meta remove_unused:dependency prop Div_unique, function div *)

axiom Div_bound :
  forall x:int, y:int.
   infix_gteq x 0 /\ infix_gt y 0 ->
   infix_lseq 0 (div x y) /\ infix_lseq (div x y) x

(* meta remove_unused:dependency prop Div_bound, function div *)

axiom Mod_1 : forall x:int. mod x 1 = 0

(* meta remove_unused:dependency prop Mod_1, function mod *)

axiom Div_1 : forall x:int. div x 1 = x

(* meta remove_unused:dependency prop Div_1, function div *)

axiom Div_inf :
  forall x:int, y:int. infix_lseq 0 x /\ infix_ls x y -> div x y = 0

(* meta remove_unused:dependency prop Div_inf, function div *)

axiom Div_inf_neg :
  forall x:int, y:int.
   infix_ls 0 x /\ infix_lseq x y -> div (prefix_mn x) y = (- 1)

(* meta remove_unused:dependency prop Div_inf_neg, function div *)

axiom Mod_0 : forall y:int. not y = 0 -> mod 0 y = 0

(* meta remove_unused:dependency prop Mod_0, function mod *)

axiom Div_1_left : forall y:int. infix_gt y 1 -> div 1 y = 0

(* meta remove_unused:dependency prop Div_1_left, function div *)

axiom Div_minus1_left : forall y:int. infix_gt y 1 -> div (- 1) y = (- 1)

(* meta remove_unused:dependency prop Div_minus1_left, function div *)

axiom Mod_1_left : forall y:int. infix_gt y 1 -> mod 1 y = 1

(* meta remove_unused:dependency prop Mod_1_left, function mod *)

axiom Mod_minus1_left :
  forall y:int. infix_gt y 1 -> mod (- 1) y = infix_mn y 1

(* meta remove_unused:dependency prop Mod_minus1_left, function mod *)

axiom Div_mult :
  forall x:int, y:int, z:int [div (infix_pl (infix_as x y) z) x].
   infix_gt x 0 -> div (infix_pl (infix_as x y) z) x = infix_pl y (div z x)

(* meta remove_unused:dependency prop Div_mult, function div *)

axiom Mod_mult :
  forall x:int, y:int, z:int [mod (infix_pl (infix_as x y) z) x].
   infix_gt x 0 -> mod (infix_pl (infix_as x y) z) x = mod z x

(* meta remove_unused:dependency prop Mod_mult, function mod *)

(* use int.EuclideanDivision *)

type ref 'a =
  | Refqtmk [@builtin] (contents:'a)

(* use why3.Ref.Ref *)

function prefix_ex (r:ref 'a) : 'a = r.contents

(* use ref.Ref1 *)

constant empty : string = ("":string)

function concat string string : string

axiom concat_assoc [@useraxiom] :
  forall s1:string, s2:string, s3:string.
   concat (concat s1 s2) s3 = concat s1 (concat s2 s3)

axiom concat_empty [@useraxiom] :
  forall s:string. concat s empty = concat empty s /\ concat empty s = s

function length string : int

axiom length_empty [@useraxiom] : length ("":string) = 0

axiom length_concat [@useraxiom] :
  forall s1:string, s2:string.
   length (concat s1 s2) = infix_pl (length s1) (length s2)

predicate lt string string

axiom lt_empty [@useraxiom] : forall s:string. not s = empty -> lt empty s

axiom lt_not_com [@useraxiom] :
  forall s1:string, s2:string. lt s1 s2 -> not lt s2 s1

axiom lt_ref [@useraxiom] : forall s1:string. not lt s1 s1

axiom lt_trans [@useraxiom] :
  forall s1:string, s2:string, s3:string.
   ([@asym_split] lt s1 s2) && lt s2 s3 -> lt s1 s3

predicate le string string

axiom le_empty [@useraxiom] : forall s:string. le empty s

axiom le_ref [@useraxiom] : forall s1:string. le s1 s1

axiom lt_le [@useraxiom] : forall s1:string, s2:string. lt s1 s2 -> le s1 s2

axiom lt_le_eq [@useraxiom] :
  forall s1:string, s2:string.
   le s1 s2 -> ([@asym_split] lt s1 s2) || s1 = s2

axiom le_trans [@useraxiom] :
  forall s1:string, s2:string, s3:string.
   ([@asym_split] le s1 s2) && le s2 s3 -> le s1 s3

function s_at string int : string

axiom at_out_of_range [@useraxiom] :
  forall s:string, i:int.
   ([@asym_split] infix_ls i 0) || infix_gteq i (length s) ->
   s_at s i = empty

axiom at_empty [@useraxiom] : forall i:int. s_at empty i = empty

axiom at_length [@useraxiom] :
  forall s:string, i:int.
   let j = s_at s i in
   if infix_lseq 0 i /\ infix_ls i (length s) then length j = 1
   else length j = 0

axiom concat_at [@useraxiom] :
  forall s1:string, s2:string.
   let s = concat s1 s2 in
   forall i:int.
    ([@asym_split]
     infix_lseq 0 i /\ infix_ls i (length s1) -> s_at s i = s_at s1 i) &&
    (infix_lseq (length s1) i /\ infix_ls i (length s) ->
     s_at s i = s_at s2 (infix_mn i (length s1)))

function substring string int int : string

axiom substring_out_of_range [@useraxiom] :
  forall s:string, i:int, x:int.
   ([@asym_split] infix_ls i 0) || infix_gteq i (length s) ->
   substring s i x = empty

axiom substring_of_length_zero_or_less [@useraxiom] :
  forall s:string, i:int, x:int.
   infix_lseq x 0 -> substring s i x = ("":string)

axiom substring_of_empty [@useraxiom] :
  forall i:int, x:int. substring ("":string) i x = ("":string)

axiom substring_smaller [@useraxiom] :
  forall s:string, i:int, x:int.
   infix_lseq (length (substring s i x)) (length s)

axiom substring_smaller_x [@useraxiom] :
  forall s:string, i:int, x:int.
   infix_gteq x 0 -> infix_lseq (length (substring s i x)) x

axiom substring_length [@useraxiom] :
  forall s:string, i:int, x:int.
   ([@asym_split] infix_gteq x 0) && infix_lseq 0 i /\ infix_ls i (length s) ->
   (if infix_gt (infix_pl i x) (length s)
    then length (substring s i x) = infix_mn (length s) i
    else length (substring s i x) = x)

axiom substring_at [@useraxiom] :
  forall s:string, i:int. s_at s i = substring s i 1

axiom substring_substring [@useraxiom] :
  forall s:string, ofs:int, len:int, ofsqt:int, lenqt:int.
   infix_lseq 0 ofs /\ infix_lseq ofs (length s) ->
   infix_lseq 0 len ->
   infix_lseq (infix_pl ofs len) (length s) ->
   infix_lseq 0 ofsqt /\ infix_lseq ofsqt len ->
   infix_lseq 0 lenqt ->
   infix_lseq (infix_pl ofsqt lenqt) len ->
   substring (substring s ofs len) ofsqt lenqt =
   substring s (infix_pl ofs ofsqt) lenqt

axiom concat_substring [@useraxiom] :
  forall s:string, ofs:int, len:int, lenqt:int.
   infix_lseq 0 ofs /\ infix_lseq ofs (length s) ->
   infix_lseq 0 len ->
   infix_lseq (infix_pl ofs len) (length s) ->
   infix_lseq 0 lenqt ->
   infix_lseq 0 (infix_pl (infix_pl ofs len) lenqt) /\
   infix_lseq (infix_pl (infix_pl ofs len) lenqt) (length s) ->
   concat (substring s ofs len) (substring s (infix_pl ofs len) lenqt) =
   substring s ofs (infix_pl len lenqt)

predicate prefixof string string

axiom prefixof_substring [@useraxiom] :
  forall s1:string, s2:string.
   prefixof s1 s2 <-> s1 = substring s2 0 (length s1)

axiom prefixof_concat [@useraxiom] :
  forall s1:string, s2:string. prefixof s1 (concat s1 s2)

axiom prefixof_empty [@useraxiom] : forall s2:string. prefixof ("":string) s2

axiom prefixof_empty2 [@useraxiom] :
  forall s1:string. not s1 = empty -> not prefixof s1 ("":string)

predicate suffixof string string

axiom suffixof_substring [@useraxiom] :
  forall s1:string, s2:string.
   suffixof s1 s2 <->
   s1 = substring s2 (infix_mn (length s2) (length s1)) (length s1)

axiom suffixof_concat [@useraxiom] :
  forall s1:string, s2:string. suffixof s2 (concat s1 s2)

axiom suffixof_empty [@useraxiom] : forall s2:string. suffixof ("":string) s2

axiom suffixof_empty2 [@useraxiom] :
  forall s1:string. not s1 = empty -> not suffixof s1 ("":string)

predicate contains string string

axiom contains_prefixof [@useraxiom] :
  forall s1:string, s2:string. prefixof s1 s2 -> contains s2 s1

axiom contains_suffixof [@useraxiom] :
  forall s1:string, s2:string. suffixof s1 s2 -> contains s2 s1

axiom contains_empty [@useraxiom] :
  forall s2:string. contains ("":string) s2 <-> s2 = empty

axiom contains_empty2 [@useraxiom] :
  forall s1:string. contains s1 ("":string)

axiom contains_substring [@useraxiom] :
  forall s1:string, s2:string, i:int.
   substring s1 i (length s2) = s2 -> contains s1 s2

axiom contains_concat [@useraxiom] :
  forall s1:string, s2:string.
   ([@asym_split] contains (concat s1 s2) s1) && contains (concat s1 s2) s2

axiom contains_at [@useraxiom] :
  forall s1:string, s2:string, i:int. s_at s1 i = s2 -> contains s1 s2

function indexof string string int : int

axiom indexof_empty [@useraxiom] :
  forall s:string, i:int.
   infix_lseq 0 i /\ infix_lseq i (length s) -> indexof s ("":string) i = i

axiom indexof_empty1 [@useraxiom] :
  forall s:string, i:int.
   let j = indexof ("":string) s i in
   ([@asym_split] j = (- 1)) ||
   ([@asym_split] s = ("":string)) && i = j /\ j = 0

axiom indexof_contains [@useraxiom] :
  forall s1:string, s2:string.
   let j = indexof s1 s2 0 in
   contains s1 s2 ->
   ([@asym_split] infix_lseq 0 j /\ infix_lseq j (length s1)) &&
   substring s1 j (length s2) = s2

axiom contains_indexof [@useraxiom] :
  forall s1:string, s2:string, i:int.
   infix_gteq (indexof s1 s2 i) 0 -> contains s1 s2

axiom not_contains_indexof [@useraxiom] :
  forall s1:string, s2:string, i:int.
   not contains s1 s2 -> indexof s1 s2 i = (- 1)

axiom substring_indexof [@useraxiom] :
  forall s1:string, s2:string, i:int.
   let j = indexof s1 s2 i in
   infix_gteq j 0 -> substring s1 j (length s2) = s2

axiom indexof_out_of_range [@useraxiom] :
  forall i:int, s1:string, s2:string.
   not (infix_lseq 0 i /\ infix_lseq i (length s1)) ->
   indexof s1 s2 i = (- 1)

axiom indexof_in_range [@useraxiom] :
  forall s1:string, s2:string, i:int.
   let j = indexof s1 s2 i in
   infix_lseq 0 i /\ infix_lseq i (length s1) ->
   ([@asym_split] j = (- 1)) || infix_lseq i j /\ infix_lseq j (length s1)

axiom indexof_contains_substring [@useraxiom] :
  forall s1:string, s2:string, i:int.
   ([@asym_split] infix_lseq 0 i /\ infix_lseq i (length s1)) &&
   contains (substring s1 i (infix_mn (length s1) i)) s2 ->
   infix_lseq i (indexof s1 s2 i) /\ infix_lseq (indexof s1 s2 i) (length s1)

function replace string string string : string

axiom replace_empty [@useraxiom] :
  forall s1:string, s3:string. replace s1 ("":string) s3 = concat s3 s1

axiom replace_not_contains [@useraxiom] :
  forall s1:string, s2:string, s3:string.
   not contains s1 s2 -> replace s1 s2 s3 = s1

axiom replace_empty2 [@useraxiom] :
  forall s2:string, s3:string.
   let s4 = replace empty s2 s3 in if s2 = empty then s4 = s3 else s4 = empty

axiom replace_substring_indexof [@useraxiom] :
  forall s1:string, s2:string, s3:string.
   let j = indexof s1 s2 0 in
   replace s1 s2 s3 =
   (if infix_ls j 0 then s1
    else concat (concat (substring s1 0 j) s3)
         (substring s1 (infix_pl j (length s2))
          (infix_mn (infix_mn (length s1) j) (length s2))))

function replaceall string string string : string

axiom replaceall_empty1 [@useraxiom] :
  forall s1:string, s3:string. replaceall s1 ("":string) s3 = s1

axiom not_contains_replaceall [@useraxiom] :
  forall s1:string, s2:string, s3:string.
   not contains s1 s2 -> replaceall s1 s2 s3 = s1

function to_int string : int

axiom to_int_gt_minus_1 [@useraxiom] :
  forall s:string. infix_gteq (to_int s) (- 1)

axiom to_int_empty [@useraxiom] : to_int ("":string) = (- 1)

predicate is_digit (s:string) =
  ([@asym_split] infix_lseq 0 (to_int s) /\ infix_lseq (to_int s) 9) &&
  length s = 1

function from_int int : string

axiom from_int_negative [@useraxiom] :
  forall i:int. infix_ls i 0 <-> from_int i = empty

axiom from_int_to_int [@useraxiom] :
  forall i:int.
   if infix_gteq i 0 then to_int (from_int i) = i
   else to_int (from_int i) = (- 1)

(* use string.String *)

type (->) 'a 'b

function infix_at ('a -> 'b) 'a : 'b

(* use why3.HighOrd.HighOrd *)

type map 'a 'b = 'a -> 'b

function get (f:'a -> 'b) (x:'a) : 'b = infix_at f x

function set (f:'a -> 'b) (x:'a) (v:'b) : 'a -> 'b =
  fun (y:'a) -> if y = x then v else infix_at f y

function mixfix_lbrb (f:'a -> 'b) (x:'a) : 'b = infix_at f x

function mixfix_lblsmnrb (f:'a -> 'b) (x:'a) (v:'b) : 'a -> 'b = set f x v

(* use map.Map *)

function const (v:'b) : 'a -> 'b = fun (us [@__dummy__]:'a) -> v

(* use map.Const *)

type option 'a =
  | None
  | Some 'a

predicate is_none (o:option 'a) =
  match o with
  | None -> true
  | Some _ -> false
  end

axiom is_noneqtspec [@W:non_conservative_extension:N] :
  forall o:option 'a. [@hyp_name:Ensures] is_none o <-> o = (None: option 'a)

(* meta remove_unused:dependency prop is_noneqtspec, predicate is_none *)

(* use option.Option *)

type array [@extraction:array] 'a

function elts [@is_field_id] [@builtin] (array 'a) : int -> 'a

function length1 [@is_field_id] [@builtin] (array 'a) : int

axiom arrayqtinvariant [@extraction:array] :
  forall self:array 'a [self.length1].
   [@hyp_name:TypeInvariant] infix_lseq 0 (self.length1)

(* meta model_record function length1 *)

(* meta model_record function elts *)

function mixfix_lbrb1 (a:array 'a) (i:int) : 'a = infix_at (a.elts) i

function mixfix_lblsmnrb1 (array 'a) int 'a : array 'a

axiom mixfix_lblsmnrbqtspecqt0 [@W:non_conservative_extension:N] :
  forall a:array 'a, i:int, v:'a.
   [@hyp_name:Ensures] (mixfix_lblsmnrb1 a i v).length1 = a.length1

axiom mixfix_lblsmnrbqtspec [@W:non_conservative_extension:N] :
  forall a:array 'a, i:int, v:'a.
   [@hyp_name:Ensures] (mixfix_lblsmnrb1 a i v).elts = set (a.elts) i v

(* meta remove_unused:dependency prop mixfix_lblsmnrbqtspecqt0,
  function mixfix_lblsmnrb1 *)

(* meta remove_unused:dependency prop mixfix_lblsmnrbqtspec,
  function mixfix_lblsmnrb1 *)

function make int 'a : array 'a

axiom make_spec [@useraxiom] :
  forall n:int, v:'a.
   infix_gteq n 0 ->
   (forall i:int.
     infix_lseq 0 i /\ infix_ls i n -> mixfix_lbrb1 (make n v) i = v) /\
   (make n v).length1 = n

(* use array.Array *)

type hval =
  | HStr string
  | HInt int
  | HArr hval_list
  | HMap hpairs
  | HNode hval
  with hval_list =
    | HNil
    | HCons hval hval_list
  with hpairs =
    | PNil
    | PCons string hval hpairs

function hval_iter_get_other hval int : hval

function hval_iter_len_other hval : int

constant pycsl_none : int

function hpairs_key_eq string string : bool

axiom hpairs_key_eqqtspec [@W:non_conservative_extension:N] :
  forall a:string, b:string.
   [@hyp_name:Ensures] hpairs_key_eq a b = True <-> a = b

(* meta remove_unused:dependency prop hpairs_key_eqqtspec,
  function hpairs_key_eq *)

function pairs_get (p1:hpairs) (k1:string) : option hval =
  match p1 with
  | PNil -> None: option hval
  | PCons kqt v t ->
      if hpairs_key_eq k1 kqt = True then Some v else pairs_get t k1
  end

function hval_opaque_str hval : string

function hstr_of (h:hval) : string =
  match h with
  | HStr s -> s
  | _ -> hval_opaque_str h
  end

function hint_of (h:hval) : int = match h with
  | HInt i -> i
  | _ -> 0
  end

function hval_truthy (h:hval) : bool =
  match h with
  | HStr s -> if not hpairs_key_eq s ("":string) = True then True else False
  | HInt i -> if not i = 0 then True else False
  | HArr l -> match l with
      | HNil -> False
      | _ -> True
      end
  | HMap p1 -> match p1 with
      | PNil -> False
      | _ -> True
      end
  | HNode _ -> True
  end

function hval_list_str_mem (l1:hval_list) (x6:string) : bool =
  match l1 with
  | HNil -> False
  | HCons h t ->
      if match h with
      | HStr s -> hpairs_key_eq s x6 = True
      | _ -> false
      end then True else hval_list_str_mem t x6
  end

function hval_str_mem (h:hval) (x6:string) : bool =
  match h with
  | HArr l1 -> hval_list_str_mem l1 x6
  | _ -> False
  end

function hval_list_len (l2:hval_list) : int =
  match l2 with
  | HNil -> 0
  | HCons _ t -> infix_pl 1 (hval_list_len t)
  end

function hval_len (h:hval) : int =
  match h with
  | HArr l2 -> hval_list_len l2
  | _ -> 0
  end

constant l2 [@introduced] : hval_list

constant i [@introduced] : int

constant x8 [@introduced] : hval

constant x9 [@introduced] : hval_list

axiom H6 [@introduced] : l2 = HCons x8 x9

constant infix_lseqqtresultqtunused [@id:unused] [@model_trace:result]
  [@introduced] [@eid:2662] [@call_result:69:24:69:30:w20_v10.mlw] : bool =
  if infix_lseq i 0 then True else False

axiom H7 [@introduced] : not infix_lseq i 0

constant infix_mnqtresultqtunused [@id:unused] [@model_trace:result]
  [@introduced] [@eid:2658] [@call_result:69:59:69:66:w20_v10.mlw] : int =
  infix_mn i 1

