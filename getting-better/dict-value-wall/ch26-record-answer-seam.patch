diff --git a/test-suite/corpus/pycsl-reference/3140_gen37_ch26_hval_receiver_get_or_str.py b/test-suite/corpus/pycsl-reference/3140_gen37_ch26_hval_receiver_get_or_str.py
new file mode 100644
index 00000000..cf0e832c
--- /dev/null
+++ b/test-suite/corpus/pycsl-reference/3140_gen37_ch26_hval_receiver_get_or_str.py
@@ -0,0 +1,34 @@
+r"""Test 3140 — gen #37 ch26 (expected PASS): the receiver-form defaulted read over a heterogeneous
+`Dict[str, PyVal]` record, `(rec.get(k1) or {}).get(k2, "") or ""` (the shape of the emitter's own
+`pycsl._record_answer`, the soundness chokepoint's reader). At base the outer `.get` fell to the
+receiver-dropped `get_2 <hash k2> <hash "">` (the record erased, an int where a string is
+expected: L3-tc failed). Now it is the K7 `pairs_get` match over the LOWERED receiver (missing key
+or non-map receiver -> the default), and `<hval> or "<lit>"` keeps the operand when truthy,
+projected to its `HStr` carrier. A record WITHOUT the outer key answers "" (CPython: "").
+Twins: 3141, 3142 (must FAIL).
+"""
+# pycsl-expected: PASS
+from typing import Dict
+
+
+#@ requires True
+#@ ensures True
+#@ assigns \nothing
+def record_answer(rec: Dict[str, PyVal]) -> str:
+    return (rec.get("prover-result") or {}).get("answer", "") or ""
+
+
+#@ requires True
+#@ ensures \result == ""
+#@ assigns \nothing
+def answer_of_empty() -> str:
+    rec: Dict[str, PyVal] = {}
+    return (rec.get("prover-result") or {}).get("answer", "") or ""
+
+
+if __name__ == "__main__":
+    assert record_answer({}) == ""
+    assert record_answer({"prover-result": {"answer": "Valid"}}) == "Valid"
+    assert record_answer({"prover-result": None}) == ""
+    assert answer_of_empty() == ""
+    print("ok")
diff --git a/test-suite/corpus/pycsl-reference/3141_gen37_ch26_hval_receiver_get_or_str_false_claim.py b/test-suite/corpus/pycsl-reference/3141_gen37_ch26_hval_receiver_get_or_str_false_claim.py
new file mode 100644
index 00000000..4a553f27
--- /dev/null
+++ b/test-suite/corpus/pycsl-reference/3141_gen37_ch26_hval_receiver_get_or_str_false_claim.py
@@ -0,0 +1,19 @@
+r"""Test 3141 — gen #37 ch26 (expected FAIL): FALSE twin of 3140. The record CARRIES
+`{"prover-result": {"answer": "Valid"}}`, so CPython returns "Valid", and `\result == ""` must
+stay UNPROVED. Non-vacuity of the seam: the receiver-form `.get` reads the record (a facade that
+answered the default whatever the record held would prove this false claim).
+"""
+# pycsl-expected: FAIL
+from typing import Dict
+
+
+#@ requires True
+#@ ensures \result == ""
+#@ assigns \nothing
+def answer_of_valid() -> str:
+    rec: Dict[str, PyVal] = {"prover-result": {"answer": "Valid"}}
+    return (rec.get("prover-result") or {}).get("answer", "") or ""
+
+
+if __name__ == "__main__":
+    print(repr(answer_of_valid()))
