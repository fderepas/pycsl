--- /dev/null
+++ b/test-suite/corpus/pycsl-reference/0715.proofs/rocq/DirBlitInvariant.v
@@ -0,0 +1,296 @@
+(* Validation of UnixFs.Dir.insert_preserves_dir_invariant_blit and
+ * UnixFs.Dir.zero_preserves_dir_invariant_blit — the FOLDED byte-rung
+ * directory-invariant maintenance facts for the dir mutators
+ * (_write_dir_entry / _zero_entry).
+ *
+ * THE PROBLEM these solve (getting-better/20260618-2030 §"the EXACT human-gated
+ * lemma to finish"): the existing maintenance lemmas (zero_preserves_uniq,
+ * insert_preserves_uniq_folded) need the SLOT-decode value `slot_inode d1 5 s`
+ * as a HYPOTHESIS — but materializing that abstract slot atom in a mutator body
+ * (from the blitted bytes, via the slot_inode_byte_decode keystone) re-triggers
+ * the E-match explosion: the literal byte VALUE term `disk[off]` and the abstract
+ * slot atoms `slot_inode/uniq/slots_lt32` cannot coexist in one VC.
+ *
+ * THE FOLD: state a SINGLE lemma whose HYPOTHESES are PURE BYTES (the blitted
+ * inode bytes + the byte-region frame for k<>s) and whose CONCLUSION is the
+ * FULL conjunction the body must prove: the slot VALUE decode, the slot-locality
+ * FRAME, uniq d1, and slots_lt32 d1. The byte->slot decode rung (slot_inode_byte_
+ * decode + field_to_str_frame) is discharged INSIDE this lemma (offline, here +
+ * Lean). The os body provides ONLY byte facts (folded from its blit loop); the
+ * lemma trigger is byte-keyed; so NO byte term and NO slot atom ever coexist in
+ * a body VC.
+ *
+ * Faithful interpretation of the Why3 symbols (the cross-validation contract,
+ * combining SlotInodeByteDecode.v + FieldToStrFrame.v + DirInvariantMaintenance.v):
+ *   - `array int` read d[b]    <-> abstract byte reader rd : disk -> Z -> Z.
+ *   - slot_inode d blk k       <-> 256 * rd d (slot_off blk k) + rd d (slot_off blk k + 1).
+ *   - slot_name d blk k        <-> field_to_str over rd d, the scan-to-first-null
+ *                                  decode of the 30-byte name field at slot_off blk k + 2
+ *                                  (the SAME model as FieldToStrFrame.v / 0712).
+ *   - uniq / slots_lt32        <-> the FOLDED block-5 predicates (same as
+ *                                  DirInvariantMaintenance.v).
+ *
+ * The byte-region frame hypothesis `forall b. region b -> rd d1 b = rd d0 b`
+ * (every byte of block 5 OUTSIDE slot s's 32-byte window agrees) is EXACTLY what
+ * the os loop establishes (the blit only touches slot s). From it we derive,
+ * INSIDE this lemma:
+ *   - the slot-frame `forall k<>s. slot_inode/slot_name d1 5 k = d0 5 k`
+ *     (slot k's windows are inside the framed region — disjoint from slot s);
+ *   - the value `slot_inode d1 5 s = 256*b0 + b1` (from the two blitted bytes).
+ *
+ * Verified under Coq 8.20.1. No Admitted, no Axiom (only Section Variables). *)
+
+Require Import Coq.ZArith.ZArith.
+Require Import Coq.Lists.List.
+Require Import Lia.
+Import ListNotations.
+Open Scope Z_scope.
+
+Module UnixFs.
+Module Dir.
+Section Blit.
+
+Variable disk : Type.
+(* rd d b : the byte at offset b of disk d. *)
+Variable rd : disk -> Z -> Z.
+
+Definition slot_off (blk k : Z) : Z := blk * 512 + 32 * k.
+
+(* ---- the concrete decodes (identical to the keystone proofs) ---- *)
+
+Definition slot_inode (d : disk) (blk k : Z) : Z :=
+  256 * (rd d (slot_off blk k)) + rd d (slot_off blk k + 1).
+
+(* the scan-to-first-null name decode (identical to FieldToStrFrame.v) *)
+Fixpoint scan (rdf : Z -> Z) (off : Z) (fuel : nat) : list Z :=
+  match fuel with
+  | O => []
+  | S m => if Z.eqb (rdf off) 0 then [] else rdf off :: scan rdf (Z.succ off) m
+  end.
+
+Definition field_to_str (rdf : Z -> Z) (off width : Z) : list Z :=
+  scan rdf off (Z.to_nat width).
+
+Definition slot_name (d : disk) (blk k : Z) : list Z :=
+  field_to_str (rd d) (slot_off blk k + 2) 30.
+
+(* ---- the FOLDED block-5 invariants (identical to DirInvariantMaintenance.v) ---- *)
+
+Definition uniq (d : disk) : Prop :=
+  forall i j : Z,
+    0 <= i < 16 -> 0 <= j < 16 ->
+    slot_inode d 5 i <> 0 -> slot_inode d 5 i < 32 ->
+    slot_inode d 5 j <> 0 -> slot_inode d 5 j < 32 ->
+    slot_name d 5 i = slot_name d 5 j -> i = j.
+
+Definition slots_lt32 (d : disk) : Prop :=
+  forall k : Z, 0 <= k < 16 -> slot_inode d 5 k < 32.
+
+(* ---- the scan frame (identical to FieldToStrFrame.v) ---- *)
+
+Lemma scan_frame :
+  forall (rda rdb : Z -> Z) (fuel : nat) (off : Z),
+    (forall j, (j < fuel)%nat -> rda (off + Z.of_nat j) = rdb (off + Z.of_nat j)) ->
+    scan rda off fuel = scan rdb off fuel.
+Proof.
+  intros rda rdb.
+  induction fuel as [| m IH]; intros off Hagree.
+  - reflexivity.
+  - assert (Hhead : rda off = rdb off).
+    { specialize (Hagree 0%nat ltac:(lia)).
+      rewrite Z.add_0_r in Hagree. exact Hagree. }
+    simpl scan. rewrite Hhead.
+    destruct (Z.eqb (rdb off) 0) eqn:Hb.
+    + reflexivity.
+    + f_equal.
+      apply IH. intros j Hj.
+      specialize (Hagree (S j) ltac:(lia)).
+      replace (Z.succ off + Z.of_nat j) with (off + Z.of_nat (S j)) by lia.
+      exact Hagree.
+Qed.
+
+Lemma field_to_str_frame :
+  forall (rda rdb : Z -> Z) (off width : Z),
+    0 <= width ->
+    (forall i, 0 <= i < width -> rda (off + i) = rdb (off + i)) ->
+    field_to_str rda off width = field_to_str rdb off width.
+Proof.
+  intros rda rdb off width Hw Hagree.
+  unfold field_to_str. apply scan_frame.
+  intros j Hj.
+  apply Hagree. split.
+  - lia.
+  - rewrite <- (Z2Nat.id width) by lia.
+    apply Nat2Z.inj_lt. exact Hj.
+Qed.
+
+(* ---- the byte-region frame -> slot frame bridge (the heart of the fold) ----
+
+   The os blit at slot s touches ONLY bytes in [slot_off 5 s, slot_off 5 s + 32).
+   Its loop establishes that EVERY block-5 byte OUTSIDE that window agrees with d0.
+   For k <> s with 0 <= k < 16, slot k's full 32-byte window
+   [slot_off 5 k, slot_off 5 k + 32) is DISJOINT from slot s's window, hence
+   entirely inside the framed region — so slot_inode and slot_name at k are
+   preserved. We package the byte-region frame as agreement on every byte b with
+   0 <= b < 512 (a block-5 offset) that is OUTSIDE slot s's window.
+
+   This bridge is proved ONCE here (so the heavy field_to_str_frame term is
+   kernel-checked exactly once) and APPLIED opaquely by both maintenance
+   theorems below. *)
+
+Lemma slot_frame_of_region :
+  forall (d0 d1 : disk) (s : Z),
+    0 <= s < 16 ->
+    (forall b : Z, 0 <= b < 512 ->
+        (b < 32 * s \/ 32 * s + 32 <= b) ->
+        rd d1 (5 * 512 + b) = rd d0 (5 * 512 + b)) ->
+    forall k : Z, 0 <= k < 16 -> k <> s ->
+      slot_inode d1 5 k = slot_inode d0 5 k /\
+      slot_name  d1 5 k = slot_name  d0 5 k.
+Proof.
+  intros d0 d1 s Hs Hframe.
+  (* per-slot byte agreement for k <> s (slot k's window inside framed region). *)
+  assert (Hslotbytes :
+    forall k : Z, 0 <= k < 16 -> k <> s ->
+      forall j, 0 <= j < 32 -> rd d1 (slot_off 5 k + j) = rd d0 (slot_off 5 k + j)).
+  { intros k Hk Hne j Hj.
+    assert (Hbeq : slot_off 5 k + j = 5 * 512 + (32 * k + j)) by (unfold slot_off; lia).
+    rewrite Hbeq.
+    apply Hframe.
+    - lia.
+    - destruct (Z_lt_le_dec k s) as [Hks | Hsk].
+      + left. lia.
+      + right. assert (s < k) by lia. lia. }
+  intros k Hk Hne. split.
+  - unfold slot_inode.
+    pose proof (Hslotbytes k Hk Hne 0 ltac:(lia)) as Hb0k.
+    pose proof (Hslotbytes k Hk Hne 1 ltac:(lia)) as Hb1k.
+    rewrite Z.add_0_r in Hb0k.
+    rewrite Hb0k, Hb1k. reflexivity.
+  - unfold slot_name. apply field_to_str_frame; [ lia |].
+    intros i Hi.
+    replace (slot_off 5 k + 2 + i) with (slot_off 5 k + (2 + i)) by lia.
+    apply (Hslotbytes k Hk Hne (2 + i) ltac:(lia)).
+Qed.
+
+Theorem insert_preserves_dir_invariant_blit :
+  forall (d0 d1 : disk) (s b0 b1 : Z),
+    uniq d0 ->
+    slots_lt32 d0 ->
+    0 <= s < 16 ->
+    (* the two blitted inode bytes of slot s on d1: *)
+    rd d1 (slot_off 5 s) = b0 ->
+    rd d1 (slot_off 5 s + 1) = b1 ->
+    (* the inserted inode is live, in range: *)
+    256 * b0 + b1 <> 0 ->
+    256 * b0 + b1 < 32 ->
+    (* the byte-region frame: every block-5 byte OUTSIDE slot s's 32-byte window
+       agrees with d0 (what the os blit loop establishes): *)
+    (forall b : Z, 0 <= b < 512 ->
+        (b < 32 * s \/ 32 * s + 32 <= b) ->
+        rd d1 (5 * 512 + b) = rd d0 (5 * 512 + b)) ->
+    (* freshness guard (the EEXIST check): the inserted name is not already live: *)
+    (forall k : Z, 0 <= k < 16 ->
+        slot_inode d0 5 k <> 0 -> slot_inode d0 5 k < 32 ->
+        slot_name d0 5 k <> slot_name d1 5 s) ->
+    (* CONCLUSION: value + frame + uniq + slots_lt32, all at once. *)
+       slot_inode d1 5 s = 256 * b0 + b1
+    /\ (forall k : Z, 0 <= k < 16 -> k <> s ->
+           slot_inode d1 5 k = slot_inode d0 5 k /\
+           slot_name  d1 5 k = slot_name  d0 5 k)
+    /\ uniq d1
+    /\ slots_lt32 d1.
+Proof.
+  intros d0 d1 s b0 b1 Hu0 Hl0 Hs Hb0 Hb1 Hlive Hlt Hframe Hfresh.
+  (* --- the slot-locality FRAME for k <> s (applied opaquely) --- *)
+  pose proof (slot_frame_of_region d0 d1 s Hs Hframe) as Hsf.
+  (* --- the slot s VALUE decode --- *)
+  assert (Hval : slot_inode d1 5 s = 256 * b0 + b1).
+  { unfold slot_inode. rewrite Hb0, Hb1. reflexivity. }
+  (* --- uniq d1 (insert: slot s fresh-live, rest framed) --- *)
+  assert (Hu1 : uniq d1).
+  { intros i j Hi Hj Hil Hilt Hjl Hjlt Hnm.
+    destruct (Z.eq_dec i s) as [His | His];
+    destruct (Z.eq_dec j s) as [Hjs | Hjs].
+    - subst; reflexivity.
+    - exfalso. subst i.
+      destruct (Hsf j Hj Hjs) as [Hji Hjn].
+      apply (Hfresh j Hj).
+      + rewrite <- Hji; exact Hjl.
+      + rewrite <- Hji; exact Hjlt.
+      + rewrite <- Hjn, <- Hnm. reflexivity.
+    - exfalso. subst j.
+      destruct (Hsf i Hi His) as [Hii Hin].
+      apply (Hfresh i Hi).
+      + rewrite <- Hii; exact Hil.
+      + rewrite <- Hii; exact Hilt.
+      + rewrite <- Hin, Hnm. reflexivity.
+    - destruct (Hsf i Hi His) as [Hii Hin].
+      destruct (Hsf j Hj Hjs) as [Hji Hjn].
+      apply (Hu0 i j Hi Hj).
+      + rewrite <- Hii; exact Hil.
+      + rewrite <- Hii; exact Hilt.
+      + rewrite <- Hji; exact Hjl.
+      + rewrite <- Hji; exact Hjlt.
+      + rewrite <- Hin, <- Hjn; exact Hnm. }
+  (* --- slots_lt32 d1 --- *)
+  assert (Hl1 : slots_lt32 d1).
+  { intros k Hk. destruct (Z.eq_dec k s) as [He | Hne].
+    - subst k. rewrite Hval. exact Hlt.
+    - destruct (Hsf k Hk Hne) as [Hki _]. rewrite Hki. apply Hl0. exact Hk. }
+  exact (conj Hval (conj Hsf (conj Hu1 Hl1))).
+Qed.
+
+Print Assumptions insert_preserves_dir_invariant_blit.
+
+(* ---- the ZERO twin (remover: slot s zeroed, rest framed) ----
+
+   _zero_entry writes 32 zero bytes at slot s. So d1's slot-s inode bytes are both
+   0 (value 0 = dead), and the byte-region frame is the same. The conclusion drops
+   the freshness guard (clearing only shrinks the live set) and the value is 0. *)
+
+Theorem zero_preserves_dir_invariant_blit :
+  forall (d0 d1 : disk) (s : Z),
+    uniq d0 ->
+    slots_lt32 d0 ->
+    0 <= s < 16 ->
+    rd d1 (slot_off 5 s) = 0 ->
+    rd d1 (slot_off 5 s + 1) = 0 ->
+    (forall b : Z, 0 <= b < 512 ->
+        (b < 32 * s \/ 32 * s + 32 <= b) ->
+        rd d1 (5 * 512 + b) = rd d0 (5 * 512 + b)) ->
+       slot_inode d1 5 s = 0
+    /\ (forall k : Z, 0 <= k < 16 -> k <> s ->
+           slot_inode d1 5 k = slot_inode d0 5 k /\
+           slot_name  d1 5 k = slot_name  d0 5 k)
+    /\ uniq d1
+    /\ slots_lt32 d1.
+Proof.
+  intros d0 d1 s Hu0 Hl0 Hs Hb0 Hb1 Hframe.
+  pose proof (slot_frame_of_region d0 d1 s Hs Hframe) as Hsf.
+  assert (Hval : slot_inode d1 5 s = 0).
+  { unfold slot_inode. rewrite Hb0, Hb1. lia. }
+  assert (Hu1 : uniq d1).
+  { intros i j Hi Hj Hil Hilt Hjl Hjlt Hnm.
+    assert (His : i <> s) by (intro; subst; rewrite Hval in Hil; apply Hil; reflexivity).
+    assert (Hjs : j <> s) by (intro; subst; rewrite Hval in Hjl; apply Hjl; reflexivity).
+    destruct (Hsf i Hi His) as [Hii Hin].
+    destruct (Hsf j Hj Hjs) as [Hji Hjn].
+    apply (Hu0 i j Hi Hj).
+    - rewrite <- Hii; exact Hil.
+    - rewrite <- Hii; exact Hilt.
+    - rewrite <- Hji; exact Hjl.
+    - rewrite <- Hji; exact Hjlt.
+    - rewrite <- Hin, <- Hjn; exact Hnm. }
+  assert (Hl1 : slots_lt32 d1).
+  { intros k Hk. destruct (Z.eq_dec k s) as [He | Hne].
+    - subst k. rewrite Hval. lia.
+    - destruct (Hsf k Hk Hne) as [Hki _]. rewrite Hki. apply Hl0. exact Hk. }
+  exact (conj Hval (conj Hsf (conj Hu1 Hl1))).
+Qed.
+
+Print Assumptions zero_preserves_dir_invariant_blit.
+
+End Blit.
+End Dir.
+End UnixFs.
