diff --git a/test-suite/corpus/pycsl-reference/0715.proofs/lean/DirBlitInvariant.lean b/test-suite/corpus/pycsl-reference/0715.proofs/lean/DirBlitInvariant.lean
new file mode 100644
index 0000000..6d3cb58
--- /dev/null
+++ b/test-suite/corpus/pycsl-reference/0715.proofs/lean/DirBlitInvariant.lean
@@ -0,0 +1,225 @@
+/- Validation of UnixFs.Dir.insert_preserves_dir_invariant_blit and
+   UnixFs.Dir.zero_preserves_dir_invariant_blit -- Lean 4 mirror of
+   ../rocq/DirBlitInvariant.v (the FOLDED byte-rung directory-invariant
+   maintenance facts for the dir mutators _write_dir_entry / _zero_entry).
+
+   THE FOLD: a SINGLE lemma whose HYPOTHESES are PURE BYTES (the blitted inode
+   bytes + the byte-region frame for k<>s) and whose CONCLUSION is the FULL
+   conjunction the os body must prove: the slot VALUE decode, the slot-locality
+   FRAME, uniq d1, and slots_lt32 d1. The byte->slot decode rung is discharged
+   INSIDE this lemma; the os body provides ONLY byte facts; the lemma trigger is
+   byte-keyed, so NO byte term and NO slot atom coexist in a body VC.
+
+   Faithful interpretation (combining SlotInodeByteDecode + FieldToStrFrame +
+   DirInvariantMaintenance):
+     - `array int` read d[b]    <-> abstract byte reader rd : Disk -> Int -> Int.
+     - slot_inode d blk k       <-> 256 * rd d (slot_off blk k) + rd d (slot_off blk k + 1).
+     - slot_name d blk k        <-> field_to_str over rd d (scan-to-first-null
+                                    name decode of the 30-byte field at slot_off+2).
+     - uniq / slots_lt32        <-> the FOLDED block-5 predicates.
+
+   Verified under Lean 4 (core only, no Mathlib). No sorry. -/
+
+namespace UnixFs
+namespace Dir
+section Blit
+
+variable {Disk : Type}
+variable (rd : Disk → Int → Int)
+
+def slot_off (blk k : Int) : Int := blk * 512 + 32 * k
+
+-- the concrete inode decode (identical to SlotInodeByteDecode)
+def slot_inode (d : Disk) (blk k : Int) : Int :=
+  256 * rd d (slot_off blk k) + rd d (slot_off blk k + 1)
+
+-- the scan-to-first-null name decode (identical to FieldToStrFrame)
+def scan (rdf : Int → Int) (off : Int) : Nat → List Int
+  | 0 => []
+  | Nat.succ m => if rdf off = 0 then [] else rdf off :: scan rdf (off + 1) m
+
+def field_to_str (rdf : Int → Int) (off width : Int) : List Int :=
+  scan rdf off width.toNat
+
+def slot_name (d : Disk) (blk k : Int) : List Int :=
+  field_to_str (rd d) (slot_off blk k + 2) 30
+
+-- the FOLDED block-5 invariants (identical to DirInvariantMaintenance)
+def uniq (d : Disk) : Prop :=
+  ∀ i j : Int, 0 ≤ i → i < 16 → 0 ≤ j → j < 16 →
+    slot_inode rd d 5 i ≠ 0 → slot_inode rd d 5 i < 32 →
+    slot_inode rd d 5 j ≠ 0 → slot_inode rd d 5 j < 32 →
+    slot_name rd d 5 i = slot_name rd d 5 j → i = j
+
+def slots_lt32 (d : Disk) : Prop :=
+  ∀ k : Int, 0 ≤ k → k < 16 → slot_inode rd d 5 k < 32
+
+-- the scan frame (identical to FieldToStrFrame)
+theorem scan_frame (rd0 rd1 : Int → Int) :
+    ∀ (fuel : Nat) (off : Int),
+      (∀ j, j < fuel → rd0 (off + (j : Int)) = rd1 (off + (j : Int))) →
+      scan rd0 off fuel = scan rd1 off fuel := by
+  intro fuel
+  induction fuel with
+  | zero => intro off _; rfl
+  | succ m ih =>
+    intro off hagree
+    have hhead : rd0 off = rd1 off := by
+      have h := hagree 0 (by omega); simpa using h
+    have htail : scan rd0 (off + 1) m = scan rd1 (off + 1) m := by
+      apply ih (off + 1)
+      intro j hj
+      have h := hagree (j + 1) (by omega)
+      have hcast : off + ((j : Int) + 1) = off + 1 + (j : Int) := by omega
+      push_cast at h; rw [hcast] at h; exact h
+    simp only [scan, hhead, htail]
+
+theorem field_to_str_frame
+    (rd0 rd1 : Int → Int) (off width : Int)
+    (_hw : 0 ≤ width)
+    (hagree : ∀ i : Int, 0 ≤ i → i < width → rd0 (off + i) = rd1 (off + i)) :
+    field_to_str rd0 off width = field_to_str rd1 off width := by
+  unfold field_to_str
+  apply scan_frame rd0 rd1 width.toNat off
+  intro j hj
+  have hjw : (j : Int) < width := by
+    have : ((width.toNat : Int)) = width := Int.toNat_of_nonneg _hw
+    omega
+  have h := hagree (j : Int) (by omega) hjw
+  simpa using h
+
+/-- The byte-region frame -> slot frame bridge (the heart of the fold), proved
+    ONCE and applied opaquely by both maintenance theorems. Slot k's 32-byte
+    window (k <> s, both in range) is disjoint from slot s's window, so it lies
+    entirely in the framed block-5 region. -/
+theorem slot_frame_of_region (d0 d1 : Disk) (s : Int)
+    (hs0 : 0 ≤ s) (hs1 : s < 16)
+    (hframe : ∀ b : Int, 0 ≤ b → b < 512 →
+        (b < 32 * s ∨ 32 * s + 32 ≤ b) →
+        rd d1 (5 * 512 + b) = rd d0 (5 * 512 + b)) :
+    ∀ k : Int, 0 ≤ k → k < 16 → k ≠ s →
+      slot_inode rd d1 5 k = slot_inode rd d0 5 k ∧
+      slot_name rd d1 5 k = slot_name rd d0 5 k := by
+  -- per-slot byte agreement for k <> s
+  have hslotbytes : ∀ k : Int, 0 ≤ k → k < 16 → k ≠ s →
+      ∀ j : Int, 0 ≤ j → j < 32 →
+        rd d1 (slot_off 5 k + j) = rd d0 (slot_off 5 k + j) := by
+    intro k hk0 hk1 hne j hj0 hj1
+    have hbeq : slot_off 5 k + j = 5 * 512 + (32 * k + j) := by unfold slot_off; omega
+    rw [hbeq]
+    apply hframe
+    · omega
+    · omega
+    · omega
+  intro k hk0 hk1 hne
+  refine ⟨?_, ?_⟩
+  · unfold slot_inode
+    have hb0 := hslotbytes k hk0 hk1 hne 0 (by omega) (by omega)
+    have hb1 := hslotbytes k hk0 hk1 hne 1 (by omega) (by omega)
+    simp only [Int.add_zero] at hb0
+    rw [hb0, hb1]
+  · unfold slot_name
+    apply field_to_str_frame (rd d1) (rd d0) (slot_off 5 k + 2) 30 (by omega)
+    intro i hi0 hi1
+    have hcast : slot_off 5 k + 2 + i = slot_off 5 k + (2 + i) := by omega
+    rw [hcast]
+    exact hslotbytes k hk0 hk1 hne (2 + i) (by omega) (by omega)
+
+/-- INSERT (writer _write_dir_entry): slot s becomes live with a fresh inode/name
+    (bytes b0,b1 blitted), the rest framed. Conclude value + frame + uniq +
+    slots_lt32 in ONE step. -/
+theorem insert_preserves_dir_invariant_blit (d0 d1 : Disk) (s b0 b1 : Int)
+    (hu0 : uniq rd d0)
+    (hl0 : slots_lt32 rd d0)
+    (hs0 : 0 ≤ s) (hs1 : s < 16)
+    (hb0 : rd d1 (slot_off 5 s) = b0)
+    (hb1 : rd d1 (slot_off 5 s + 1) = b1)
+    (_hlive : 256 * b0 + b1 ≠ 0)
+    (hlt : 256 * b0 + b1 < 32)
+    (hframe : ∀ b : Int, 0 ≤ b → b < 512 →
+        (b < 32 * s ∨ 32 * s + 32 ≤ b) →
+        rd d1 (5 * 512 + b) = rd d0 (5 * 512 + b))
+    (hfresh : ∀ k : Int, 0 ≤ k → k < 16 →
+        slot_inode rd d0 5 k ≠ 0 → slot_inode rd d0 5 k < 32 →
+        slot_name rd d0 5 k ≠ slot_name rd d1 5 s) :
+       slot_inode rd d1 5 s = 256 * b0 + b1
+    ∧ (∀ k : Int, 0 ≤ k → k < 16 → k ≠ s →
+           slot_inode rd d1 5 k = slot_inode rd d0 5 k ∧
+           slot_name rd d1 5 k = slot_name rd d0 5 k)
+    ∧ uniq rd d1
+    ∧ slots_lt32 rd d1 := by
+  have hsf := slot_frame_of_region rd d0 d1 s hs0 hs1 hframe
+  have hval : slot_inode rd d1 5 s = 256 * b0 + b1 := by
+    unfold slot_inode; rw [hb0, hb1]
+  have hu1 : uniq rd d1 := by
+    intro i j hi0 hi1 hj0 hj1 hil hilt hjl hjlt hnm
+    by_cases his : i = s <;> by_cases hjs : j = s
+    · rw [his, hjs]
+    · exfalso; subst his
+      obtain ⟨hji, hjn⟩ := hsf j hj0 hj1 hjs
+      apply hfresh j hj0 hj1 (by rw [← hji]; exact hjl) (by rw [← hji]; exact hjlt)
+      rw [← hjn, ← hnm]
+    · exfalso; subst hjs
+      obtain ⟨hii, hin⟩ := hsf i hi0 hi1 his
+      apply hfresh i hi0 hi1 (by rw [← hii]; exact hil) (by rw [← hii]; exact hilt)
+      rw [← hin, hnm]
+    · obtain ⟨hii, hin⟩ := hsf i hi0 hi1 his
+      obtain ⟨hji, hjn⟩ := hsf j hj0 hj1 hjs
+      exact hu0 i j hi0 hi1 hj0 hj1
+        (by rw [← hii]; exact hil) (by rw [← hii]; exact hilt)
+        (by rw [← hji]; exact hjl) (by rw [← hji]; exact hjlt)
+        (by rw [← hin, ← hjn]; exact hnm)
+  have hl1 : slots_lt32 rd d1 := by
+    intro k hk0 hk1
+    by_cases hks : k = s
+    · rw [hks, hval]; exact hlt
+    · obtain ⟨hki, _⟩ := hsf k hk0 hk1 hks
+      rw [hki]; exact hl0 k hk0 hk1
+  exact ⟨hval, hsf, hu1, hl1⟩
+
+/-- ZERO (remover _zero_entry): slot s zeroed (both inode bytes 0), the rest
+    framed. Conclude value=0 + frame + uniq + slots_lt32 in ONE step. -/
+theorem zero_preserves_dir_invariant_blit (d0 d1 : Disk) (s : Int)
+    (hu0 : uniq rd d0)
+    (hl0 : slots_lt32 rd d0)
+    (hs0 : 0 ≤ s) (hs1 : s < 16)
+    (hb0 : rd d1 (slot_off 5 s) = 0)
+    (hb1 : rd d1 (slot_off 5 s + 1) = 0)
+    (hframe : ∀ b : Int, 0 ≤ b → b < 512 →
+        (b < 32 * s ∨ 32 * s + 32 ≤ b) →
+        rd d1 (5 * 512 + b) = rd d0 (5 * 512 + b)) :
+       slot_inode rd d1 5 s = 0
+    ∧ (∀ k : Int, 0 ≤ k → k < 16 → k ≠ s →
+           slot_inode rd d1 5 k = slot_inode rd d0 5 k ∧
+           slot_name rd d1 5 k = slot_name rd d0 5 k)
+    ∧ uniq rd d1
+    ∧ slots_lt32 rd d1 := by
+  have hsf := slot_frame_of_region rd d0 d1 s hs0 hs1 hframe
+  have hval : slot_inode rd d1 5 s = 0 := by
+    unfold slot_inode; rw [hb0, hb1]; omega
+  have hu1 : uniq rd d1 := by
+    intro i j hi0 hi1 hj0 hj1 hil hilt hjl hjlt hnm
+    have his : i ≠ s := by
+      intro h; subst h; rw [hval] at hil; exact hil rfl
+    have hjs : j ≠ s := by
+      intro h; subst h; rw [hval] at hjl; exact hjl rfl
+    obtain ⟨hii, hin⟩ := hsf i hi0 hi1 his
+    obtain ⟨hji, hjn⟩ := hsf j hj0 hj1 hjs
+    exact hu0 i j hi0 hi1 hj0 hj1
+      (by rw [← hii]; exact hil) (by rw [← hii]; exact hilt)
+      (by rw [← hji]; exact hjl) (by rw [← hji]; exact hjlt)
+      (by rw [← hin, ← hjn]; exact hnm)
+  have hl1 : slots_lt32 rd d1 := by
+    intro k hk0 hk1
+    by_cases hks : k = s
+    · rw [hks, hval]; omega
+    · obtain ⟨hki, _⟩ := hsf k hk0 hk1 hks
+      rw [hki]; exact hl0 k hk0 hk1
+  exact ⟨hval, hsf, hu1, hl1⟩
+
+#print axioms insert_preserves_dir_invariant_blit
+#print axioms zero_preserves_dir_invariant_blit
+
+end Blit
+end Dir
+end UnixFs
diff --git a/test-suite/corpus/pycsl-reference/0715.proofs/rocq/DirBlitInvariant.v b/test-suite/corpus/pycsl-reference/0715.proofs/rocq/DirBlitInvariant.v
