      end;
      let _idx_ga = ref 0 in
      while !_idx_ga < (iter_length 0) do
        invariant { 0 <= !_idx_ga }
        variant { (iter_length 0) - !_idx_ga }
        let ga = ref ((iter_get 0 !_idx_ga)) in
        ir_stmts := Seq.snoc !ir_stmts (self__emit_ghost_assign_1 !ga);
        _idx_ga := !_idx_ga + 1
      done;
      let _idx_cp = ref 0 in
      while !_idx_cp < (iter_length 0) do
        invariant { 0 <= !_idx_cp }
        variant { (iter_length 0) - !_idx_cp }
        let cp = ref ((iter_get 0 !_idx_cp)) in
        let pa = ref (map_update_some (map_update_some (map_update_some (const (None: option int)) "stmt" 1378480597) "kind" (get_kind !cp)) "test" (self__csl_to_ir_1 (get_expr !cp))) in
        origin := 0;
        if (!origin <> 0) then begin
          pa := map_update_some !pa "origin" !origin
        end;
        ir_stmts := Seq.snoc !ir_stmts !pa;
        _idx_cp := !_idx_cp + 1
      done;
      _idx_stmt := !_idx_stmt + 1
    done;
    (materialize !ir_stmts)

