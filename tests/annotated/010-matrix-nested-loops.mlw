module PyCSL_Program
  use int.Int
  use int.EuclideanDivision
  use ref.Ref
  use seq.Seq

  let transpose (matrix: seq int) (rows: int) (cols: int) : int
    requires { ((rows >= 1) && (cols >= 1)) }
    ensures  { (result = cols) }
  =
    cols

  let multiply (a: seq int) (b: seq int) (n: int) : int
    requires { (n >= 0) }
    ensures  { (1 = 1) }
  =
    let total = ref 0 in
    let i = ref 0 in
    while (!i < n) do
      invariant { ((0 <= !i) && (!i <= n)) }
      variant { (n - !i) }
      total := !total + ((Seq.get a !i) * (Seq.get b !i));
      i := !i + 1
    done;
    !total

end