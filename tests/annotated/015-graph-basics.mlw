module PyCSL_Program
  use int.Int
  use int.EuclideanDivision
  use ref.Ref

  let shortest_path_unweighted (n: int) (start: int) (end_node: int) : int
    requires { (n >= 1) }
    requires { (start >= 0) }
    requires { (end_node >= 0) }
    ensures  { (result >= (- 1)) }
  =
    if (start > end_node) then begin
      (- 1)
    end else begin
      let dist = ref 0 in
      let current = ref start in
      while (!current < end_node) do
        invariant { (!current >= start) }
        invariant { (!dist >= 0) }
        invariant { (!dist = (!current - start)) }
        variant { (end_node - !current) }
        current := !current + 1;
        dist := !dist + 1
      done;
      !dist
    end

end