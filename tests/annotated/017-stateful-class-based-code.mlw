module PyCSL_Program
  use int.Int
  use int.EuclideanDivision
  use ref.Ref

  let counter_init () : int
    requires { (1 = 1) }
    ensures  { (result = 0) }
  =
    0

  let counter_value (v: int) : int
    requires { (v >= 0) }
    ensures  { (result = v) }
  =
    v

  let counter_increment (v: int) (amount: int) : int
    requires { ((v >= 0) && (amount >= 0)) }
    ensures  { (result = (v + amount)) }
  =
    (v + amount)

  let counter_reset () : int
    requires { (1 = 1) }
    ensures  { (result = 0) }
  =
    0

end