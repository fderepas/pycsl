module PyCSL_Program
  use int.Int
  use int.EuclideanDivision
  use ref.Ref
  use array.Array

  exception PyCSL_Continue

  let classify_numbers (values: array int) : (int, int, int)
    ensures  { ((let (_r0_, _, _) = result in _r0_) >= 0) }
    ensures  { ((let (_, _r1_, _) = result in _r1_) >= 0) }
    ensures  { ((let (_, _, _r2_) = result in _r2_) >= 0) }
    ensures  { ((((let (_r0_, _, _) = result in _r0_) + (let (_, _r1_, _) = result in _r1_)) + (let (_, _, _r2_) = result in _r2_)) = n) }
  =
    let negatives = ref 0 in
    let zeros = ref 0 in
    let positives = ref 0 in
    let n = ref (length values) in
    let i = ref 0 in
    while (!i < !n) do
      invariant { ((0 <= !i) && (!i <= !n)) }
      invariant { (!negatives >= 0) }
      invariant { (!zeros >= 0) }
      invariant { (!positives >= 0) }
      invariant { (((!negatives + !zeros) + !positives) = !i) }
      variant { (!n - !i) }
      if (values[!i] < 0) then begin
        negatives := !negatives + 1
      end else begin
        if (values[!i] = 0) then begin
          zeros := !zeros + 1
        end else begin
          positives := !positives + 1
        end
      end;
      i := !i + 1
    done;
    (!negatives, !zeros, !positives)

  let first_positive_prefix_sum (values: array int) (threshold: int) : int
    requires { (threshold > 0) }
    ensures  { (result >= 0) }
  =
    let total = ref 0 in
    let n = ref (length values) in
    let i = ref 0 in
    while (!i < !n) do
      invariant { ((0 <= !i) && (!i <= !n)) }
      invariant { (!total >= 0) }
      variant { (!n - !i) }
      try
      if (values[!i] <= 0) then begin
        i := !i + 1;
        raise PyCSL_Continue
      end;
      total := !total + values[!i];
      if (!total >= threshold) then begin
        i := !n
      end else begin
        i := !i + 1
      end
      with PyCSL_Continue -> () end
    done;
    !total

end