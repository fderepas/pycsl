module PyCSL_Program
  use int.Int
  use int.EuclideanDivision
  use ref.Ref
  use array.Array

  let select_max_non_overlapping (starts: array int) (ends: array int) : int
    requires { (1 = 1) }
    ensures  { (result >= 0) }
  =
    let n = ref (length starts) in
    let count = ref 0 in
    let last_end = ref (- 1) in
    let i = ref 0 in
    while (!i < !n) do
      invariant { ((0 <= !i) && (!i <= !n)) }
      invariant { (!count >= 0) }
      variant { (!n - !i) }
      if (starts[!i] >= !last_end) then begin
        count := !count + 1;
        last_end := ends[!i]
      end;
      i := !i + 1
    done;
    !count

end