module PyCSL_Program
  use int.Int
  use ref.Ref
  use seq.Seq

  let word_frequencies (words: seq int) : int
  =
    let n = ref (Seq.length words) in
    let total = ref 0 in
    let i = ref 0 in
    while (!i < !n) do
      invariant { ((0 <= !i) && (!i <= !n)) }
      invariant { (!total >= 0) }
      invariant { (!total = !i) }
      variant { (!n - !i) }
      total := !total + 1;
      i := !i + 1
    done;
    !total

  let unique_sorted_values (values: seq int) : int
    requires { (1 = 1) }
    ensures  { (1 = 1) }
  =
    let n = ref (Seq.length values) in
    let total = ref 0 in
    let i = ref 0 in
    while (!i < !n) do
      invariant { ((0 <= !i) && (!i <= !n)) }
      variant { (!n - !i) }
      total := !total + (Seq.get values !i);
      i := !i + 1
    done;
    !total

  let index_by_id (row_id: int) : int
    requires { (row_id >= 0) }
    ensures  { (result = row_id) }
  =
    row_id

end