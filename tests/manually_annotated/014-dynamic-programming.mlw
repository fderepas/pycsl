module PyCSL_Program
  use int.Int
  use int.EuclideanDivision
  use ref.Ref
  use array.Array

  let knapsack_01 (weights: array int) (values: array int) (capacity: int) : int
    requires { (capacity >= 0) }
    requires { ((length values) = (length weights)) }
    ensures  { (result >= 0) }
  =
    let n = ref (length weights) in
    let remaining = ref capacity in
    let total_value = ref 0 in
    let i = ref 0 in
    while (!i < !n) do
      invariant { ((0 <= !i) && (!i <= !n)) }
      invariant { (!n = (length weights)) }
      variant { (!n - !i) }
      if (weights[!i] <= !remaining) then begin
        remaining := !remaining - weights[!i];
        total_value := !total_value + values[!i]
      end;
      i := !i + 1
    done;
    !total_value

end