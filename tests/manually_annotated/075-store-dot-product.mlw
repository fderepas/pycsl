module PyCSL_Program
  use int.Int
  use int.EuclideanDivision
  use ref.Ref
  use array.Array

  let dot_product (a: array int) (b: array int) (n: int) : int
    requires { (((n >= 0 && n <= length a) && (n >= 0 && n <= length b)) && (n >= 0)) }
    ensures  { (result >= 0) }
  =
    let acc = ref 0 in
    let i = ref 0 in
    while (!i < n) do
      acc := (!acc + (a[!i] * b[!i]));
      i := (!i + 1)
    done;
    !acc

end