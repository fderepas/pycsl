module PyCSL_Program
  use int.Int
  use int.EuclideanDivision
  use ref.Ref
  use array.Array

  let max_element (arr: array int) (n: int) : int
    requires { ((n >= 0 && n <= length arr) && (n >= 1)) }
    ensures  { (result >= arr[0]) }
  =
    let m = ref arr[0] in
    let i = ref 1 in
    while (!i < n) do
      if (arr[!i] > !m) then begin
        m := arr[!i]
      end;
      i := (!i + 1)
    done;
    !m

end