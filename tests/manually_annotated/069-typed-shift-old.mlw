module PyCSL_Program
  use int.Int
  use int.EuclideanDivision
  use ref.Ref
  use array.Array

  let shift_array (arr: array int) (n: int) (delta: int) : int
    requires { (((n >= 0 && n <= length arr) && (n >= 0)) && (delta >= 0)) }
    ensures  { (result = 0) }
  =
    let i = ref 0 in
    while (!i < n) do
      arr[!i] <- (arr[!i] + delta);
      i := (!i + 1)
    done;
    0

end