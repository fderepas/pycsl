module PyCSL_Program
  use int.Int
  use int.EuclideanDivision
  use ref.Ref
  use array.Array

  let increment_first (arr: array int) (n: int) : int
    requires { ((n >= 0 && n <= length arr) && (n >= 1)) }
    ensures  { (arr[0] = ((arr[0] at PRE) + 1)) }
  =
    label PRE in
    arr[0] <- (arr[0] + 1);
    0

end