module PyCSL_Program
  use int.Int
  use int.EuclideanDivision
  use ref.Ref
  use seq.Seq

  let count_non_empty_lines (lines: seq int) : int
    requires { (1 = 1) }
    ensures  { (result >= 0) }
  =
    let n = ref (Seq.length lines) in
    let count = ref 0 in
    let i = ref 0 in
    while (!i < !n) do
      invariant { ((0 <= !i) && (!i <= !n)) }
      invariant { (!count >= 0) }
      invariant { (!count <= !i) }
      variant { (!n - !i) }
      if ((Seq.get lines !i) > 0) then begin
        count := !count + 1
      end;
      i := !i + 1
    done;
    !count

  let main () : int
    requires { (1 = 1) }
    ensures  { (result = 0) }
  =
    0

end