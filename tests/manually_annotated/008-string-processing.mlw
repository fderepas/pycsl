module PyCSL_Program
  use int.Int
  use int.EuclideanDivision
  use ref.Ref
  use seq.Seq

  let normalize (chars: seq int) : int
    requires { (1 = 1) }
    ensures  { (result >= 0) }
  =
    let n = ref (Seq.length chars) in
    let count = ref 0 in
    let i = ref 0 in
    while (!i < !n) do
      invariant { ((0 <= !i) && (!i <= !n)) }
      invariant { (!count >= 0) }
      invariant { (!count <= !i) }
      variant { (!n - !i) }
      if ((Seq.get chars !i) >= 0) then begin
        count := !count + 1
      end;
      i := !i + 1
    done;
    !count

  let is_palindrome (cleaned: seq int) : int
    requires { (1 = 1) }
    ensures  { (result >= 0) }
  =
    let n = ref (Seq.length cleaned) in
    let left = ref 0 in
    let right = ref (!n - 1) in
    let result_val = ref 1 in
    while (!left < !right) do
      invariant { (0 <= !left) }
      invariant { (!right >= (- 1)) }
      invariant { (!result_val >= 0) }
      variant { ((!right - !left) + 1) }
      if ((Seq.get cleaned !left) <> (Seq.get cleaned !right)) then begin
        result_val := 0;
        left := !right
      end else begin
        left := !left + 1;
        right := !right - 1
      end
    done;
    !result_val

  let word_count (tokens: seq int) : int
    requires { (1 = 1) }
    ensures  { (result >= 0) }
  =
    let n = ref (Seq.length tokens) in
    !n

end