module PyCSL_Program
  use int.Int
  use int.EuclideanDivision
  use ref.Ref
  use seq.Seq

  let linear_search (values: seq int) (target: int) : int
    requires { (1 = 1) }
    ensures  { (result >= (- 1)) }
  =
    let n = ref (Seq.length values) in
    let i = ref 0 in
    let found = ref (- 1) in
    while (!i < !n) do
      invariant { ((0 <= !i) && (!i <= !n)) }
      invariant { (!found >= (- 1)) }
      variant { (!n - !i) }
      if ((Seq.get values !i) = target) then begin
        found := !i;
        i := !n
      end else begin
        i := !i + 1
      end
    done;
    !found

  let binary_search (sorted_values: seq int) (target: int) : int
    requires { (1 = 1) }
    ensures  { (result >= (- 1)) }
  =
    let n = ref (Seq.length sorted_values) in
    let left = ref 0 in
    let right = ref (!n - 1) in
    let found = ref (- 1) in
    while (!left <= !right) do
      invariant { (0 <= !left) }
      invariant { (!right >= (- 1)) }
      invariant { (!right <= (!n - 1)) }
      invariant { (!found >= (- 1)) }
      variant { ((!right - !left) + 1) }
      let mid = ref (div (!left + !right) 2) in
      let value = ref (Seq.get sorted_values !mid) in
      if (!value = target) then begin
        found := !mid;
        left := (!right + 1)
      end else begin
        if (!value < target) then begin
          left := (!mid + 1)
        end else begin
          right := (!mid - 1)
        end
      end
    done;
    !found

end