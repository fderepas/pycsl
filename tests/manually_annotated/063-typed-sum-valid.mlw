module PyCSL_Program
  use int.Int
  use int.EuclideanDivision
  use ref.Ref
  use array.Array

  let sum_array (arr: array int) (n: int) : int
    requires { ((n >= 0 && n <= length arr) && (n >= 0)) }
    ensures  { (result >= 0) }
  =
    let s = ref 0 in
    let i = ref 0 in
    while (!i < n) do
      invariant { (((0 <= !i) && (!i <= n)) && (!s >= 0)) }
      variant { (n - !i) }
      s := (!s + arr[!i]);
      i := (!i + 1)
    done;
    !s

end