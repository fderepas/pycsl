Here are all the special (dunder) methods, grouped by their categories:

# Representation

- __repr__
- __str__
- __format__
- __bytes__
- __fspath__

# Number / conversion

- __bool__
- __complex__
- __int__
- __float__
- __hash__
- __index__

# Collections

- __len__
- __getitem__
- __setitem__
- __delitem__
- __contains__

# Iteration

- __iter__
- __aiter__
- __next__
- __anext__
- __reversed__

# Callable / coroutine execution

- __call__
- __await__

# Context management

- __enter__
- __exit__
- __aenter__
- __aexit__

# Creation and destruction

- __new__
- __init__
- __del__

- Attribute management

- __getattr__
- __getattribute__
- __setattr__
- __delattr__
- __dir__

# Descriptors

- __get__
- __set__
- __delete__
- __set_name__

# Class / metaclass machinery

- __instancecheck__
- __subclasscheck__
- __prepare__
- __init_subclass__
- __subclasshook__
- __mro_entries__
- __class_getitem__

# Unary operators / built-ins

- __neg__ (-x)
- __pos__ (+x)
- __abs__ (abs())
- __invert__ (~x)
- __round__ (round())

# Comparison operators

- __lt__ (<)
- __le__ (<=)
- __eq__ (==)
- __ne__ (!=)
- __gt__ (>)
- __ge__ (>=)

# Arithmetic operators (forward)

- __add__ (+)
- __sub__ (-)
- __mul__ (*)
- __truediv__ (/)
- __floordiv__ (//)
- __mod__ (%)
- __divmod__ (divmod())
- __pow__ (**)
- __matmul__ (@)

# Bitwise operators (forward)

- __and__ (&)
- __or__ (|)
- __xor__ (^)
- __lshift__ (<<)
- __rshift__ (>>)

# Reversed / reflected operators (swapped operands)

- __radd__
- __rsub__
- __rmul__
- __rtruediv__
- __rfloordiv__
- __rmod__
- __rdivmod__
- __rpow__
- __rmatmul__
- __rand__
- __ror__
- __rxor__
- __rlshift__
- __rrshift__

# Augmented / in-place assignment operators

- __iadd__ (+=)
- __isub__ (-=)
- __imul__ (*=)
- __itruediv__ (/=)
- __ifloordiv__ (//=)
- __imod__ (%=)
- __ipow__ (**=)
- __imatmul__ (@=)
- __iand__ (&=)
- __ior__ (|=)
- __ixor__ (^=)
- __ilshift__ (<<=)
- __irshift__ (>>=)

